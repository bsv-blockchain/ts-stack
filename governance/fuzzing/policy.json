{
  "schemaVersion": 1,
  "lastReviewed": "2026-07-26",
  "owner": "ts-stack-maintainers",
  "reviewBy": "2026-08-26",
  "tool": {
    "package": "@jazzer.js/core",
    "version": "4.0.0",
    "runtime": "Node.js 24",
    "rootCommand": "pnpm test:fuzz",
    "runner": "scripts/fuzzing.mjs",
    "ciWorkflow": ".github/workflows/ci.yml",
    "scheduledWorkflow": ".github/workflows/fuzz-tests.yml",
    "builtInBugDetectors": ["command-injection", "path-traversal", "prototype-pollution"]
  },
  "campaign": {
    "pullRequestMode": "regression",
    "pullRequestScope": "affected targets",
    "pullRequestCoverage": true,
    "scheduledMode": "fuzzing",
    "scheduledSecondsPerTarget": 300,
    "scheduledMaximumParallel": 6,
    "targetTimeoutMilliseconds": 5000,
    "maximumInputBytes": 65536,
    "rssLimitMegabytes": 4096,
    "artifactRetentionDays": 30,
    "corpusRetentionDays": 30,
    "committedCorpus": "fuzz/corpus",
    "cumulativeCorpus": ".fuzz-corpus",
    "artifactDirectory": "artifacts/fuzz",
    "crashPromotionRequired": true,
    "networkAccess": false,
    "secrets": false
  },
  "coverage": {
    "requiredAreas": [
      "sdk",
      "helpers",
      "messaging",
      "middleware",
      "network",
      "overlays",
      "wallet",
      "native"
    ],
    "minimumTargets": 29,
    "minimumCriticalTargets": 26,
    "minimumImplementationPackages": 29,
    "selectionPrinciple": "Prioritize untrusted parsers, binary and protocol framing, authentication and payment boundaries, integrity calculations, cross-runtime differential implementations, wallet persistence, and native memory interfaces."
  },
  "targets": [
    "sdk-codecs",
    "did-codecs",
    "did-client-instructions",
    "simple-did",
    "authsocket-events",
    "paymail-address",
    "message-box-host",
    "overlay-topics-linkage",
    "p2p-messages",
    "auth-proof",
    "auth-express-values",
    "payment-402-challenge",
    "payment-replay",
    "fund-wallet-cli",
    "project-config",
    "amount-conversion",
    "overlay-advertisement",
    "overlay-integrity",
    "overlay-reorg",
    "gasp-initial-sync",
    "btms-backend-fields",
    "mandala-encoding",
    "wallet-pairing",
    "wallet-binary-json",
    "wallet-header-guards",
    "wallet-script",
    "btms-parsers",
    "btms-permission-boundary",
    "verifast-batch"
  ]
}
