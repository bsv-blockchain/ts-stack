{
  "name": "lch-reference-app",
  "version": "0.1.0",
  "private": true,
  "author": "BSV Association",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-notices.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test --deny-warnings",
    "format:check": "pnpm --workspace-root exec prettier --check \"apps/lch-reference/**/*.{css,html,json,md,mjs,ts}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@bsv/lch": "workspace:^",
    "@bsv/sdk": "workspace:^"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "^1.76.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "license": "SEE LICENSE IN LICENSE.txt"
}
