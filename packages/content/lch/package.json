{
  "name": "@bsv/lch",
  "version": "0.3.0",
  "description": "BRC-170 Licensed Content Header reference implementation",
  "author": "BSV Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./overlay-acquisition": {
      "types": "./dist/overlayAcquisition.d.ts",
      "import": "./dist/overlayAcquisition.js",
      "default": "./dist/overlayAcquisition.js"
    },
    "./overlay-covenant": {
      "types": "./dist/overlayCovenant.d.ts",
      "import": "./dist/overlayCovenant.js",
      "default": "./dist/overlayCovenant.js"
    }
  },
  "bin": {
    "lch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:mutation": "pnpm --filter @bsv/output-knowledge build && pnpm build",
    "typecheck": "tsc --noEmit",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/content/lch/**/*.{json,md,ts}\"",
    "lint": "oxlint src test --deny-warnings",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watchman=false",
    "test:property": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watchman=false test/cbor.property.test.ts test/overlay-acquisition-codec.property.test.ts test/overlay-acquisition-covenant-terms.property.test.ts test/overlay-acquisition-covenant-settlement.property.test.ts test/overlay-acquisition-license.property.test.ts test/overlay-acquisition-covenant.property.test.ts test/overlay-acquisition-covenant-seller.property.test.ts",
    "test:browser": "pnpm build && node ../../../scripts/check-browser-package.mjs .",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand --watchman=false",
    "vectors:update": "pnpm build && node scripts/regenerate-brc170-vectors.mjs",
    "pack:check": "pnpm build && node ../../../scripts/check-package-artifact.mjs . --modes esm --exports LCHPublisher,LCHReader,LCHIssuer,LCHComposer,LCHMultipayBuyer,LCHHttpServer,WalletPaymentReceiver,encodeDeterministicCbor,parseLCH,encryptSegmented --bin lch --bin-args --help --entry-exports \"./overlay-acquisition=LCH_OVERLAY_PROFILES|LCH_OVERLAY_LIMITS|LCH_OVERLAY_COVENANT_MECHANISMS|validateLCHOverlayCovenantTerms|validateLCHOverlayCovenantPromise|validateLCHOverlayCovenantWindow|decodeLCHOverlayBinding|decodeLCHCollectorRevenue|decodeLCHOverlayJSON|decodeUnverifiedLCHOverlayContext|encodeLCHOverlayContext|decodeLCHOverlayReleasePolicy|LCHOverlayPaidDomain|LCHOverlayPaidSeller|LCHOverlayPaidCustody|lchOverlayCustodyBinding|lchOverlayPaidEntitlementDigest|validateLCHOverlayFixedRenderPolicy|createLCHOverlayFixedRenderAgreement|validateLCHOverlayFixedRenderAgreement|LCH_OVERLAY_PAID_MECHANISMS|validateLCHOverlayCapability|validateLCHOverlayPaidTerms|validateLCHOverlayPaidWindow|validateLCHOverlayPaidPromise|validateLCHOverlayAuthority|validateLCHOverlayPaidRoles|decodeLCHLookupSettlement|decodeLCHOverlayPaymentEvidence|bindLCHOverlayPaidSettlement\" --entry-exports \"./overlay-covenant=decodeLCHOverlayCovenantProfilePurchaseEvidence|bindLCHOverlayCovenantProfileSettlement|LCHOverlayCovenantSeller|LCHOverlayCovenantDomain|decodeLCHCollectorRevenueProfile|bindLCHCollectorRevenueProfile|validateLCHCollectorPreparation|validateLCHOverlayCovenantProfileTerms|validateLCHOverlayCovenantProfilePromise|validateLCHOverlayCovenantProfileWindow|lchOverlayCovenantEntitlementDigest|decodeLCHCovenantSettlement|decodeLCHOverlayCovenantPurchaseEvidence|bindLCHOverlayCovenantSettlement|validateLCHOverlayCovenantTerms|validateLCHOverlayCovenantPromise|validateLCHOverlayCovenantWindow|LCH_OVERLAY_COVENANT_MECHANISMS\"",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@bsv/chirp": "^0.1.0",
    "@bsv/sdk": "^2.4.1 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@bsv/chirp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bsv/chirp": "workspace:^",
    "@bsv/sdk": "workspace:^",
    "@jest/globals": "^30.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "fast-check": "^4.9.0",
    "jest": "^30.5.1",
    "oxlint": "^1.83.0",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/content/lch"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/content/lch#readme",
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "keywords": [
    "bsv",
    "brc-170",
    "lch",
    "licensed-content",
    "odrl",
    "c2pa"
  ],
  "typesVersions": {
    "*": {
      "overlay-acquisition": [
        "dist/overlayAcquisition.d.ts"
      ],
      "overlay-covenant": [
        "dist/overlayCovenant.d.ts"
      ]
    }
  }
}
