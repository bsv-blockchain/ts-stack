{
  "name": "@bsv/did-client",
  "version": "1.2.1",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "description": "Discover DID records with ease",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/cjs/mod.js",
  "module": "dist/esm/mod.js",
  "types": "dist/types/mod.d.ts",
  "files": [
    "dist",
    "src",
    "mod.ts",
    "LICENSE.txt",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/mod.d.ts",
      "import": "./dist/esm/mod.js",
      "require": "./dist/cjs/mod.js"
    },
    "./*.ts": {
      "types": "./dist/types/src/*.d.ts",
      "import": "./dist/esm/src/*.js",
      "require": "./dist/cjs/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run build && jest --passWithNoTests",
    "test:watch": "npm run build && jest --watch",
    "test:coverage": "npm run build && jest --coverage --passWithNoTests",
    "lint:ci": "oxlint src",
    "lint": "oxlint src",
    "build": "npm run build:ts && npm run build:umd",
    "build:ts": "tsc -b && tsconfig-to-dual-package tsconfig.cjs.json",
    "build:umd": "webpack --config webpack.config.js",
    "dev": "tsc -b -w",
    "prepublish": "npm run build",
    "doc": "ts2md"
  },
  "author": "Peer-to-peer Privacy Systems Research, LLC",
  "license": "Open BSV License",
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts2md": "^0.2.8",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "^6.0.3",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "oxlint": "^1.75.0"
  },
  "dependencies": {
    "@bsv/wallet-toolbox-client": "workspace:^"
  },
  "overrides": {
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/helpers/did-client"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/helpers/did-client#readme",
  "keywords": [
    "bsv",
    "did",
    "overlay",
    "identity",
    "decentralized-identifier"
  ],
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
}
