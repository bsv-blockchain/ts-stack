{
  "name": "@bsv/amountinator",
  "version": "2.1.3",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Currency amount conversion",
  "author": "Peer-to-peer Privacy Systems Research, LLC & BSV Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:property": "jest --runInBand tests/amountFormat.property.test.ts",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "build": "tsdown src/index.ts --format cjs,esm --dts --sourcemap --clean --out-dir dist --tsconfig tsconfig.build.json",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/helpers/amountinator/{src,tests}/**/*.ts\" \"packages/helpers/amountinator/*.{cjs,json,ts}\"",
    "lint": "oxlint src tests --deny-warnings",
    "pack:check": "node ../../../scripts/check-package-artifact.mjs . --exports CurrencyConverter,formatAmountWithCurrency",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/helpers/amountinator"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/helpers/amountinator#readme",
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "oxlint": "^1.75.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsdown": "0.22.14",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "@bsv/wallet-toolbox-client": "workspace:^"
  },
  "keywords": [
    "bsv",
    "currency",
    "conversion",
    "satoshis",
    "wallet"
  ],
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
}
