{
  "name": "@bsv/fund-wallet",
  "private": false,
  "version": "1.4.2",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "description": "fund a metanet wallet",
  "keywords": [
    "bsv",
    "wallet",
    "funding",
    "faucet",
    "transactions"
  ],
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "deggen",
  "type": "module",
  "bin": {
    "fund-metanet": "./dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --sourcemap --clean --out-dir dist --tsconfig tsconfig.build.json",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/helpers/fund-wallet/src/**/*.ts\" \"packages/helpers/fund-wallet/*.{json,ts}\"",
    "lint": "oxlint src --deny-warnings",
    "pack:check": "node ../../../scripts/check-package-artifact.mjs . --modes cli --skip-types --bin fund-metanet --bin-args --help",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.mjs",
    "dev": "node dist/index.mjs",
    "test": "vitest run",
    "test:property": "vitest run src/cli.property.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@bsv/wallet-toolbox": "workspace:^",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "^4.9.0",
    "oxlint": "^1.75.0",
    "tsdown": "0.22.14",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/helpers/fund-wallet"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/helpers/fund-wallet#readme",
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
}
