{
  "name": "@bsv/simple",
  "version": "0.4.1",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Simplified, modular helper library for BSV blockchain development",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/helpers/simple"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "oxlint src",
    "lint:ci": "oxlint src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bsv",
    "bitcoin",
    "blockchain",
    "wallet",
    "inscription",
    "messagebox",
    "tokens",
    "certification"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.txt",
  "dependencies": {
    "@bsv/message-box-client": "workspace:^",
    "@bsv/wallet-toolbox": "workspace:^",
    "@bsv/wallet-toolbox-client": "workspace:^"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "oxlint": "^1.75.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/helpers/simple#readme",
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
}
