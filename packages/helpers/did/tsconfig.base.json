{
  "extends": "../../../config/typescript/dual-runtime.json",
  "compilerOptions": {
    "lib": ["dom", "ESNext"],
    "module": "NodeNext",
    "target": "esnext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "rootDir": "./",
    "strict": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["jest", "node"]
  },
  "files": ["mod.ts"],
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
