{
  "name": "@bsv/did",
  "version": "0.2.2",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "description": "SD-JWT VC and did:key helpers for BSV SDK identities",
  "keywords": [
    "bsv",
    "did",
    "identity",
    "credentials",
    "sd-jwt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/mod.d.ts",
        "default": "./dist/mod.js"
      },
      "require": {
        "types": "./dist/mod.d.cts",
        "default": "./dist/mod.cjs"
      }
    },
    "./*.ts": {
      "import": {
        "types": "./dist/src/*.d.ts",
        "default": "./dist/src/*.js"
      },
      "require": {
        "types": "./dist/src/*.d.cts",
        "default": "./dist/src/*.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown mod.ts --format cjs,esm --dts --sourcemap --clean --out-dir dist --platform neutral --tsconfig tsconfig.base.json --unbundle",
    "dev": "pnpm build --watch",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/helpers/did/{src,tests}/**/*.ts\" \"packages/helpers/did/*.{js,json,ts}\"",
    "lint": "oxlint src tests --deny-warnings",
    "pack:check": "node ../../../scripts/check-package-artifact.mjs . --exports BsvDid,SdJwtVcHolder,SdJwtVcIssuer,SdJwtVcPresenter,SdJwtVcVerifier,applyDisclosures,base64UrlDecode,base64UrlDecodeJson,base64UrlEncode,base64UrlEncodeJson,createKeyBindingJwt,decodeDidKey,decodeJwt,disclosureDigest,encodeBase58Multibase,generateQrCode,jwkToPublicKey,parseDisclosure,parseSdJwt,privateKeyToJwk,publicKeyFromDid,publicKeyToDidKey,publicKeyToJwk,selectDisclosures,serializeSdJwt,signCompact,signJwt,verificationMethodForDid,verifyCompact,verifyJwt,verifyKeyBindingJwt",
    "prepublishOnly": "pnpm build",
    "test": "jest",
    "test:browser": "pnpm build && node ../../../scripts/check-browser-package.mjs .",
    "test:coverage": "jest --coverage",
    "test:property": "jest --runInBand --watchman=false --runTestsByPath tests/codec.property.test.ts",
    "test:watch": "jest --watch",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "author": "Peer-to-peer Privacy Systems Research, LLC & BSV Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsdown": "0.22.14",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "oxlint": "^1.75.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/helpers/did"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/helpers/did#readme",
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
}
