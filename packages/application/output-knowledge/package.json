{
  "name": "@bsv/output-knowledge",
  "version": "0.1.0",
  "description": "Durable BRC-192 application output knowledge and interchangeable source adapters",
  "author": "BSV Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "sqlite": [
        "dist/storage/SQLiteJournal.d.ts"
      ],
      "sources": [
        "dist/sources/index.d.ts"
      ],
      "proposals": [
        "dist/proposals/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "import": "./dist/sources/index.js",
      "default": "./dist/sources/index.js"
    },
    "./sqlite": {
      "types": "./dist/storage/SQLiteJournal.d.ts",
      "import": "./dist/storage/SQLiteJournal.js",
      "default": "./dist/storage/SQLiteJournal.js"
    },
    "./proposals": {
      "types": "./dist/proposals/index.d.ts",
      "import": "./dist/proposals/index.js",
      "default": "./dist/proposals/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/application/output-knowledge/**/*.{json,md,ts}\"",
    "lint": "oxlint src test --deny-warnings",
    "test": "pnpm build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watchman=false",
    "test:property": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watchman=false test/journal.property.test.ts",
    "test:browser": "pnpm build && node ../../../scripts/check-browser-package.mjs .",
    "test:coverage": "pnpm build && node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand --watchman=false",
    "pack:check": "pnpm build && node ../../../scripts/check-package-artifact.mjs . --modes esm --exports OutputKnowledge,BitcoinKnowledge,MemoryJournal,IndexedDBJournal,parseSourceCurrentnessRules --entry-exports \"./proposals=ProposalPolicyRegistry|AuthorDocumentPolicy|proposalChannelKey|validateProposalWindow|ProposalTransitions|proposalRecordToken\"",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.9.0"
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "oxlint": "^1.76.0",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "fake-indexeddb": "^6.2.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/application/output-knowledge"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/application/output-knowledge#readme",
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "keywords": [
    "bsv",
    "brc-192",
    "utxo",
    "overlay",
    "application-state"
  ]
}
