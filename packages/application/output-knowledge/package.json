    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/application/output-knowledge/**/*.{json,md,ts,mjs,html}\"",
    "lint": "oxlint src test --deny-warnings",
    "test": "pnpm build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watchman=false",
    "test:property": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watchman=false test/journal.property.test.ts test/lookup-framing.test.ts test/lookup-state.test.ts test/lookup-index-codec.test.ts test/lookup-query.test.ts test/lookup-batch.test.ts test/lookup-provider-work.test.ts test/lookup-session.test.ts test/lookup-sqlite-index.test.ts test/lookup-retention.test.ts test/lookup-provider.property.test.ts test/lookup-session-records.property.test.ts test/lookup-disclosure.property.test.ts test/revenue-lineage.property.test.ts test/revenue-lineage-package.property.test.ts test/revenue-lineage-graph.property.test.ts test/revenue-authority.property.test.ts test/root-eviction.property.test.ts test/root-advertisement-evidence.property.test.ts test/root-eviction-records.property.test.ts test/root-eviction-storage.property.test.ts test/root-eviction-commit.property.test.ts test/root-contract.property.test.ts test/root-eviction-coordination.property.test.ts test/root-eviction-maintenance.property.test.ts test/root-eviction-codec.property.test.ts test/revenue-lineage-traversal.property.test.ts test/root-eviction-service.property.test.ts test/root-eviction-scheduler.property.test.ts test/root-eviction-local-rules.property.test.ts test/proposal-send.property.test.ts test/proposal-disclosure.property.test.ts test/proposal-maintenance.property.test.ts test/lookup-send.property.test.ts test/runtime-publication.property.test.ts test/proposal-client-verification.property.test.ts test/proposal-core.property.test.ts test/proposal-current.property.test.ts test/proposal-channel.property.test.ts test/proposal-storage-channel.property.test.ts test/protected-ledger.property.test.ts test/private-publication.property.test.ts test/private-verified-publication.property.test.ts test/private-publication-coordination.property.test.ts test/private-acquisition.property.test.ts test/private-acquisition-state.property.test.ts test/private-acquisition-coordination.property.test.ts test/protected-operation.property.test.ts test/protected-operation-object.property.test.ts test/private-lookup-buyer.property.test.ts test/revenue-purchase.property.test.ts test/private-purchase-contract.property.test.ts test/private-purchase-state.property.test.ts test/private-purchase-native-clock.property.test.ts test/private-purchase-coordination.property.test.ts test/private-purchase-disclosure.property.test.ts test/private-purchase-buyer.property.test.ts test/private-purchase-wallet-native.property.test.ts test/private-purchase-evidence.property.test.ts test/private-publication-lookup.property.test.ts test/revenue-profile.property.test.ts",
    "test:browser": "pnpm build && node ../../../scripts/check-browser-package.mjs . && node ../../../scripts/check-browser-package.mjs . --budget browser-protected-budget.json && node ../../../scripts/check-browser-package.mjs . --budget browser-objects-budget.json && node ../../../scripts/check-browser-package.mjs . --budget browser-buyer-budget.json && node ../../../scripts/check-browser-package.mjs . --budget browser-purchase-buyer-budget.json && node ../../../scripts/check-browser-package.mjs . --budget browser-root-serving-budget.json && node test/browser/test.mjs",
    "test:browser:runtime": "pnpm build && node test/browser/test.mjs",
    "test:coverage": "pnpm build && node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --config jest.coverage.config.js --watchman=false",
    "pack:check": "pnpm build && node ../../../scripts/check-package-artifact.mjs . --modes esm --exports OutputKnowledge,BitcoinKnowledge,MemoryJournal,IndexedDBJournal,parseSourceCurrentnessRules --entry-exports \"./proposals=ProposalChannelHeadsQuery|proposalChannelIndexKey|ProposalChannelHeadsContract|ProposalChannelHeadsSource|ProposalCurrentChannels|ProposalSourcePolicy|ProposalPolicyRegistry|ProposalCapabilityContracts|ProposalService|ProposalJournalMaintenance|ProposalScheduler|ProposalResponseDisclosure|SDKProposalEvidence|AuthorDocumentPolicy|proposalChannelKey|validateProposalWindow|ProposalTransitions|proposalRecordToken|MemoryProposalJournal|proposalCommitKey|appendProposalWithRecovery;./proposals/sqlite=SQLiteProposalJournal;./proposals/channels-sqlite=SQLiteProposalChannelStore;./operations=MemoryOperationStateStore|IndexedDBOperationStateStore|DEFAULT_OPERATION_STATE_LIMITS;./operations/protected=ProtectedOperationStateStore|WalletProtectedOperationPayload|protectedOperationBinding|PROTECTED_OPERATION_INITIAL;./operations/objects=IndexedDBProtectedOperationObjectStore;./operations/objects/sqlite=SQLiteProtectedOperationObjectStore|NodeProtectedPayloadCodec;./operations/sqlite=SQLiteOperationStateStore;./sources/live-lookup=LiveLookupSource|prepareLiveLookupSource|liveLookupSourceBinding;./lookup=LookupResponseDisclosure|LookupProviderService|LookupProviderContracts|LookupProviderWork|LookupWake|LookupQueryRegistry|CollectionOutputQueryPolicy|LookupSessionCodec|LookupIndexCodec|lookupServingEpochExtension;./lookup/sqlite=SQLiteLookupIndex|SQLiteLookupSessions;./revenue-listing=RevenueListingAuthority|createSoftwareRevenueListingAuthority|RevenueListingLineageVerifier|RevenueListingPurchaseVerifier|REVENUE_LISTING_PURCHASE_PROFILE|REVENUE_LISTING_LINEAGE_SCHEMA|parseRevenueListingLineagePackage|REVENUE_LISTING_LINEAGE_LIMITS|RevenueListingProfileLineageVerifier|RevenueListingProfilePurchaseVerifier|parseRevenueListingProfileLineagePackage;./root-eviction=RootEvictionContracts|RootEvictionService|RootEvictionScheduler;./root-eviction/serving=RootAdvertisementServing|RootLookupServingDisclosure|rootAdvertisementServingTarget|rootLookupAdvertisementTargets;./root-eviction/sqlite=SQLiteRootEvictionStore|SQLiteRootEvictionMaintenance|SQLiteRootEvictionLocalRules;./root-eviction/evidence=SDKRootEvictionEvidence|SDKRootAdvertisementEvidence;./private/node=PrivatePublicationLookupContext|PrivateServiceDomain|PrivateServiceIdentity|NodeProtectedPayloadCodec|SQLitePrivatePublicationStore|PrivatePublicationContracts|SDKPrivatePublicationEvidence|PrivatePublicationVerificationLeases|PrivatePublicationAccess|PrivatePublicationCoordinator|PrivatePublicationDisclosure|PrivatePublicationWork|PrivatePublicationReconciler|SQLitePrivateAcquisitionStore|PrivateAcquisitionContracts|PrivateAcquisitionAccess|PrivateAcquisitionCoordinator|PrivateAcquisitionDisclosure|PrivateAcquisitionWork|PrivateAcquisitionReconciler|SDKPrivateAcquisitionFunding|SDKPrivateReleaseEvidence|WalletToolboxAcquisitionFunding|PrivatePurchaseContracts|SQLitePrivatePurchaseStore|SQLitePrivatePurchaseCommitmentStore|createPrivatePurchaseProgress|advancePrivatePurchaseProgress|parsePrivatePurchaseProgress|privatePurchaseEnvelope|privatePurchaseOperation|PrivatePurchaseCoordinator|SQLitePrivatePurchaseEvidence|PrivatePurchaseAccess|PrivatePurchaseDisclosure|ownPrivatePurchasePreparation|ownPrivatePurchaseAdmissionOutcome;./private/buyer=PrivateLookupBuyer|privateLookupBuyerBinding|PRIVATE_LOOKUP_BUYER_INITIAL|WalletToolboxBuyerPayment;./private/purchase-buyer=PrivatePurchaseBuyer|privatePurchaseBuyerBinding|PRIVATE_PURCHASE_BUYER_INITIAL;./private/purchase-wallet=WalletToolboxPurchasePayment\"",
    "prepublishOnly": "pnpm build"
  },
