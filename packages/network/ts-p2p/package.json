  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/network/ts-p2p"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/network/ts-p2p#readme",
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
