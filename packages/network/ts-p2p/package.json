{
  "name": "@bsv/teranode-listener",
  "version": "1.1.0",
  "description": "An npm package to subscribe to Teranode P2P topics in a private DHT network and log messages",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "demo": "tsx demo.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.1",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/bootstrap": "^12.0.27",
    "@libp2p/crypto": "^5.1.21",
    "@libp2p/identify": "^4.1.10",
    "@libp2p/interface": "^3.2.5",
    "@libp2p/kad-dht": "^16.4.0",
    "@libp2p/peer-id": "^6.0.12",
    "@libp2p/ping": "^3.1.9",
    "@libp2p/pnet": "^3.0.25",
    "@libp2p/pubsub-peer-discovery": "^12.0.0",
    "@libp2p/tcp": "^11.0.24",
    "@multiformats/multiaddr": "^13.0.3",
    "libp2p": "^3.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "@bsv/sdk": "workspace:^"
  },
  "keywords": [
    "teranode",
    "libp2p",
