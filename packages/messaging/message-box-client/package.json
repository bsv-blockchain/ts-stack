{
  "name": "@bsv/message-box-client",
  "version": "2.2.4",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/messaging/message-box-client"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/messaging/message-box-client#readme",
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "description": "A client for P2P messaging and payments",
  "type": "module",
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "pnpm build:ts && pnpm build:umd",
    "build:ts": "tsdown",
    "build:umd": "webpack --config webpack.config.js",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/messaging/message-box-client/**/*.{cjs,js,json,mjs,ts}\"",
    "lint": "oxlint mod.ts scripts src --deny-warnings",
    "pack:check": "pnpm build && node ../../../scripts/check-package-artifact.mjs . --exports MessageBoxClient,PeerPayClient,PeerTokenClient,RemittanceAdapter,STANDARD_PAYMENT_MESSAGEBOX,PAYMENT_REQUESTS_MESSAGEBOX,PAYMENT_REQUEST_RESPONSES_MESSAGEBOX,STANDARD_TOKEN_MESSAGEBOX,TOKEN_REQUESTS_MESSAGEBOX,TOKEN_REQUEST_RESPONSES_MESSAGEBOX,DEFAULT_PAYMENT_REQUEST_MIN_AMOUNT,DEFAULT_PAYMENT_REQUEST_MAX_AMOUNT",
    "prepublishOnly": "pnpm build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.ts --watchman=false",
    "test:browser": "pnpm build && node ../../../scripts/check-browser-package.mjs .",
    "test:integration": "node scripts/run-integration.mjs",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.ts --watchman=false --coverage",
    "test:property": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.ts --runInBand --watchman=false --runTestsByPath src/__tests/host.property.test.ts",
    "test:watch": "jest --watch",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "keywords": [
    "BSV",
    "Blockchain",
    "P2P",
    "Bitcoin",
    "SV",
    "Messaging",
    "MessageBox"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/mod.d.ts",
        "default": "./dist/mod.js"
      },
      "require": {
        "types": "./dist/mod.d.cts",
        "default": "./dist/mod.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "author": "BSV Blockchain Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "oxlint": "^1.75.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "tsdown": "0.22.14",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1"
  },
  "dependencies": {
    "@bsv/authsocket-client": "workspace:^"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
}
