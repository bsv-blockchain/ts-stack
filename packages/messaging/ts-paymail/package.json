{
  "name": "@bsv/paymail",
  "version": "2.4.6",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "description": "BSV Paymail library",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "typesVersions": {
    "*": {
      "client": [
        "dist/src/paymailClient/index.d.cts"
      ],
      "client/*": [
        "dist/src/paymailClient/*.d.cts"
      ],
      "capability": [
        "dist/src/capability/index.d.cts"
      ],
      "capability/*": [
        "dist/src/capability/*.d.cts"
      ],
      "router": [
        "dist/src/paymailRouter/index.d.cts"
      ],
      "router/*": [
        "dist/src/paymailRouter/*.d.cts"
      ],
      "errors": [
        "dist/src/errors/index.d.cts"
      ],
      "errors/*": [
        "dist/src/errors/*.d.cts"
      ]
    }
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "docs/*.md",
    "docs/specs",
    "LICENSE.txt"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/mod.browser.d.ts",
        "default": "./dist/mod.browser.js"
      },
      "import": {
        "types": "./dist/mod.d.ts",
        "default": "./dist/mod.js"
      },
      "require": {
        "types": "./dist/mod.d.cts",
        "default": "./dist/mod.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/src/paymailClient/index.d.ts",
        "default": "./dist/src/paymailClient/index.js"
      },
      "require": {
        "types": "./dist/src/paymailClient/index.d.cts",
        "default": "./dist/src/paymailClient/index.cjs"
      }
    },
    "./client/*": {
      "import": {
        "types": "./dist/src/paymailClient/*.d.ts",
        "default": "./dist/src/paymailClient/*.js"
      },
      "require": {
        "types": "./dist/src/paymailClient/*.d.cts",
        "default": "./dist/src/paymailClient/*.cjs"
      }
    },
    "./capability": {
      "import": {
        "types": "./dist/src/capability/index.d.ts",
        "default": "./dist/src/capability/index.js"
      },
      "require": {
        "types": "./dist/src/capability/index.d.cts",
        "default": "./dist/src/capability/index.cjs"
      }
    },
    "./capability/*": {
      "import": {
        "types": "./dist/src/capability/*.d.ts",
        "default": "./dist/src/capability/*.js"
      },
      "require": {
        "types": "./dist/src/capability/*.d.cts",
        "default": "./dist/src/capability/*.cjs"
      }
    },
    "./router": {
      "import": {
        "types": "./dist/src/paymailRouter/index.d.ts",
        "default": "./dist/src/paymailRouter/index.js"
      },
      "require": {
        "types": "./dist/src/paymailRouter/index.d.cts",
        "default": "./dist/src/paymailRouter/index.cjs"
      }
    },
    "./router/*": {
      "import": {
        "types": "./dist/src/paymailRouter/*.d.ts",
        "default": "./dist/src/paymailRouter/*.js"
      },
      "require": {
        "types": "./dist/src/paymailRouter/*.d.cts",
        "default": "./dist/src/paymailRouter/*.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/src/errors/index.d.ts",
        "default": "./dist/src/errors/index.js"
      },
      "require": {
        "types": "./dist/src/errors/index.d.cts",
        "default": "./dist/src/errors/index.cjs"
      }
    },
    "./errors/*": {
      "import": {
        "types": "./dist/src/errors/*.d.ts",
        "default": "./dist/src/errors/*.js"
      },
      "require": {
        "types": "./dist/src/errors/*.d.cts",
        "default": "./dist/src/errors/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:example": "pnpm build && pnpm --filter example-paymail build",
    "dev": "tsdown --watch",
    "doc": "ts2md --inputFilename=src/capability/index.ts --outputFilename=docs/capability.md --filenameSubString=capability --firstHeadingLevel=1 && ts2md --inputFilename=src/paymailClient/paymailClient.ts --outputFilename=docs/paymailClient.md --filenameSubString=paymailClient --firstHeadingLevel=1 && ts2md --inputFilename=src/paymailRouter/paymailRouter.ts --outputFilename=docs/paymailRouter.md --filenameSubString=paymailRouter --firstHeadingLevel=1",
    "docs-lint": "oxlint docs --deny-warnings",
    "ex-lint": "pnpm --filter example-paymail lint",
    "example:getProfile": "pnpm build:example && pnpm --filter example-paymail getProfile",
    "example:sendP2P": "pnpm build:example && pnpm --filter example-paymail sendP2P",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/messaging/ts-paymail/**/*.{cjs,js,json,ts}\"",
    "lint": "oxlint mod.ts mod.browser.ts src --deny-warnings",
    "pack:check": "pnpm build && node ../../../scripts/check-package-artifact.mjs . --exports Capability,PublicKeyInfrastructureCapability,PublicProfileCapability,P2pPaymentDestinationCapability,ReceiveTransactionCapability,RequestSenderValidationCapability,VerifyPublicKeyOwnerCapability,P2pReceiveBeefTransactionCapability,NegotiationCapability,TransactionNegotiationCapability,SimpleP2pOrdinalDestinationsCapability,SimpleP2pOrdinalReceiveCapability,PaymailClient,DNSResolver,HttpClient,AbstractDnsResolver,PaymailRouter,PaymailRoute,P2pPaymentDestinationRoute,PublicKeyInfrastructureRoute,ReceiveTransactionRoute,PublicProfileRoute,VerifyPublicKeyOwnerRoute,ReceiveBeefTransactionRoute,NegotiationCapabilitiesRoute,TransactionNegotiationCapabilitiesRoute,OrdinalP2pPaymentDestinationRoute,SimpleP2pOrdinalReceiveRoute,PaymailError,PaymailBadRequestError,PaymailServerResponseError --entry-exports \"./client=PaymailClient|DNSResolver|HttpClient|AbstractDnsResolver;./capability=Capability|PublicKeyInfrastructureCapability|PublicProfileCapability|P2pPaymentDestinationCapability|ReceiveTransactionCapability|RequestSenderValidationCapability|VerifyPublicKeyOwnerCapability|P2pReceiveBeefTransactionCapability|NegotiationCapability|TransactionNegotiationCapability|SimpleP2pOrdinalDestinationsCapability|SimpleP2pOrdinalReceiveCapability;./router=PaymailRouter|PaymailRoute|P2pPaymentDestinationRoute|PublicKeyInfrastructureRoute|ReceiveTransactionRoute|PublicProfileRoute|VerifyPublicKeyOwnerRoute|ReceiveBeefTransactionRoute|NegotiationCapabilitiesRoute|TransactionNegotiationCapabilitiesRoute|OrdinalP2pPaymentDestinationRoute|SimpleP2pOrdinalReceiveRoute;./errors=PaymailError|PaymailBadRequestError|PaymailServerResponseError\" && node ../../../scripts/check-auth-express-consumers.mjs @bsv/paymail",
    "prepublishOnly": "pnpm build",
    "start:example:server": "pnpm build:example && pnpm --filter example-paymail server",
    "test": "jest",
    "test:browser": "pnpm build && node ../../../scripts/check-browser-package.mjs .",
    "test:coverage": "jest --coverage",
    "test:property": "jest --runInBand --watchman=false --runTestsByPath src/__tests/paymailAddress.property.test.ts",
    "test:watch": "jest --watch",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "author": "BSV Blockchain Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/messaging/ts-paymail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/messaging/ts-paymail"
  },
  "keywords": [
    "BSV",
    "Blockchain",
    "SDK",
    "Bitcoin",
    "SV",
    "Paymail"
  ],
  "dependencies": {
    "cross-fetch": "^4.1.0",
    "joi": "^18.2.3"
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@jest/globals": "^30.4.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "express": "^5.2.1",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "oxlint": "^1.76.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts2md": "^0.2.8",
    "tsdown": "0.22.14",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6",
    "@types/express": ">=4.17.0 <6",
    "express": ">=4.18.0 <6"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    },
    "@types/express": {
      "optional": false
    },
    "express": {
      "optional": false
    }
  }
}
