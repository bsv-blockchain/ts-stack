{
  "name": "example-paymail",
  "version": "1.0.0",
  "private": true,
  "description": "Private, compiled examples for @bsv/paymail",
  "scripts": {
    "test": "pnpm typecheck",
    "build": "tsc -p tsconfig.json",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/messaging/ts-paymail/docs/examples/**/*.{json,ts}\"",
    "lint": "oxlint src --deny-warnings",
    "server": "pnpm build && node dist/cjs/src/server.js",
    "client": "pnpm build && node dist/cjs/src/client.js",
    "getProfile": "pnpm build && node dist/cjs/src/client/getProfile.js",
    "getPki": "pnpm build && node dist/cjs/src/client/getPki.js",
    "sendP2P": "pnpm build && node dist/cjs/src/client/sendP2P.js",
    "sendBeefP2P": "pnpm build && node dist/cjs/src/client/sendP2PBeef.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false"
  },
  "author": "BSV Blockchain Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "dependencies": {
    "@bsv/paymail": "workspace:^",
    "@bsv/sdk": "workspace:^",
    "express": "^5.2.1",
    "jwt-simple": "^0.5.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "^1.76.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/messaging/ts-paymail/docs/examples"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/messaging/ts-paymail/docs/examples#readme"
}
