{
  "name": "@bsv/verifast",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/verifast"
  },
  "type": "module",
  "description": "Optional C++/WASM (BDK) transaction script-verification backend for @bsv/sdk",
  "main": "dist/cjs/mod.cjs",
  "module": "dist/mod.js",
  "types": "dist/mod.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "browser": "./dist/mod.browser.js",
      "import": "./dist/mod.js",
      "require": "./dist/cjs/mod.cjs",
      "default": "./dist/mod.js"
    },
    "./umd": {
      "types": "./dist/umd.d.ts",
      "browser": "./dist/umd/verifast.js",
      "require": "./dist/umd/verifast.cjs",
      "default": "./dist/umd/verifast.cjs"
    },
    "./wasm/bdk-core.umd.js": "./dist/src/wasm/bdk-core.umd.js",
    "./wasm/bdk-core.wasm": "./dist/src/wasm/bdk-core.wasm"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-wasm.mjs && node scripts/build-cjs.mjs && rspack --config rspack.config.js && node scripts/copy-umd.mjs && node scripts/check-bundle-size.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "bench": "tsx bench/benchmark.ts",
    "bench:batch": "node --expose-gc --import tsx bench/batch-benchmark.ts",
    "test:browser": "pnpm build && node browser/test.mjs",
    "test:consumers": "pnpm build && node scripts/test-node-consumers.mjs && node browser/test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@rspack/cli": "^2.0.8",
    "@rspack/core": "^2.0.8",
    "jest": "^30.0.0",
    "puppeteer-core": "^24.42.0",
    "ts-jest": "^29.2.0",
    "ts-standard": "^12.0.2",
    "tsx": "^4.22.4",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.1.8"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=22"
  }
}
