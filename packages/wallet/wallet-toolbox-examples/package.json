  },
  "author": "Tone Engel",
  "license": "SEE LICENSE IN LICENSE.txt",
  "keywords": [
    "bsv",
    "babbage",
    "wallet",
    "BRC100"
  ],
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "oxlint src test jest.config.ts --deny-warnings",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{ts,json,md}\" \"docs/**/*.md\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "build": "tsc --build",
    "prepublish": "pnpm build && pnpm doc",
