{
  "name": "@bsv/wallet-toolbox",
  "version": "2.15.0",
  "sideEffects": false,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "BRC100 conforming wallet, wallet storage and wallet signer components",
  "main": "./out/src/index.js",
  "types": "./out/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/src/index.d.ts",
      "require": "./out/src/index.js",
      "default": "./out/src/index.js"
    },
    "./out/src/sdk": {
      "types": "./out/src/sdk/index.d.ts",
      "require": "./out/src/sdk/index.js",
      "default": "./out/src/sdk/index.js"
    },
    "./out/src/*": {
      "types": "./out/src/*.d.ts",
      "require": "./out/src/*.js"
    },
    "./package.json": "./package.json",
    "./portable": {
      "types": "./out/src/storage/portable/stream.d.ts",
      "require": "./out/src/storage/portable/stream.js",
      "default": "./out/src/storage/portable/stream.js"
    },
    "./portable/node": {
      "types": "./out/src/storage/portable/node.d.ts",
      "require": "./out/src/storage/portable/node.js",
      "default": "./out/src/storage/portable/node.js"
    }
  },
  "files": [
    "out/src/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/wallet/wallet-toolbox"
  },
  "author": "BSV Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "keywords": [
    "bsv",
    "babbage",
    "wallet",
    "BRC100"
  ],
  "scripts": {
    "test": "pnpm build && jest --testPathIgnorePatterns='man.test.ts|live.test.ts|bench.test.ts|client/test|mobile/test' --watchman=false",
    "test:watch": "pnpm build && jest --testPathIgnorePatterns='man.test.ts|live.test.ts|client/test|mobile/test' --watch",
    "test:coverage": "pnpm build && jest --testPathIgnorePatterns='man.test.ts|live.test.ts|bench.test.ts|client/test|mobile/test' --coverage --watchman=false",
    "test:property": "pnpm build && node ../../../scripts/check-wallet-property-command.mjs && jest --testPathIgnorePatterns=man.test.ts --runInBand --watchman=false --runTestsByPath src/utility/__tests/actionBatchPack.property.test.ts src/storage/snapshot/RetainedReadSnapshot.property.test.ts src/storage/snapshot/SnapshotSync.property.test.ts src/storage/snapshot/SnapshotSyncDestination.property.test.ts src/storage/snapshot/SnapshotSyncRows.property.test.ts src/storage/snapshot/archive/KnexSnapshotArchiveStore.property.test.ts src/storage/snapshot/archive/SnapshotArchiveDirectory.property.test.ts src/storage/snapshot/archive/SnapshotArchiveService.property.test.ts src/storage/snapshot/archive/SnapshotArchiveProtocol.property.test.ts src/storage/snapshot/archive/RemoteSnapshotReader.property.test.ts src/storage/snapshot/journal/SnapshotJournal.property.test.ts src/storage/portable/mysqlReadSnapshot.property.test.ts src/storage/sync/SyncPageBudget.property.test.ts src/storage/portable/CanonicalPortableChunks.property.test.ts src/storage/portable/Brc38PackedRow.test.ts src/storage/portable/Brc38Stream.test.ts src/storage/portable/Brc38KnexSource.test.ts src/storage/portable/Brc38JsonStream.property.test.ts src/storage/portable/Brc39Frame.property.test.ts src/storage/portable/Brc39StreamNode.test.ts src/storage/portable/Brc39PrivateFileNode.test.ts src/storage/portable/Brc38AuthenticatedPrivateStageNode.property.test.ts src/storage/portable/Brc38ImportExistingRows.property.test.ts src/storage/portable/Brc38ImportHistory.property.test.ts src/storage/portable/Brc38ImportIdMap.property.test.ts src/storage/portable/Brc38ImportJournal.property.test.ts src/storage/portable/Brc38ImportJournalSchema.property.test.ts src/storage/portable/Brc38ImportJournalSchemaBody.property.test.ts src/storage/portable/Brc38ImportMergeCheckpointNode.property.test.ts src/storage/portable/Brc38ImportPage.property.test.ts src/storage/portable/Brc38ImportProvenanceNode.property.test.ts src/storage/portable/Brc38ImportTargetIndexes.property.test.ts src/storage/portable/Brc38KnexDestinationFence.property.test.ts src/storage/portable/Brc38NativeCatalogNode.property.test.ts src/storage/portable/Brc38OwnedImportReads.property.test.ts src/storage/portable/Brc38PortableRows.property.test.ts src/storage/portable/Brc38PrivateChunkPipe.property.test.ts src/storage/portable/Brc38PrivateDestinationLeaseNode.property.test.ts src/storage/portable/Brc38PrivateImportJournalNode.property.test.ts src/storage/portable/Brc38PrivateImportPreviewNode.property.test.ts src/storage/portable/Brc38PrivatePublicationCopyNode.property.test.ts src/storage/portable/Brc38ProfileInventoryClaimNode.property.test.ts src/storage/portable/Brc38ProfilePhysicalIdentityNode.property.test.ts src/storage/portable/Brc38PublishedProfileReceiptNode.property.test.ts src/storage/portable/Brc38PublishedWalletData.property.test.ts src/storage/portable/Brc38SemanticStage.property.test.ts src/storage/portable/Brc38StagingAdmissionNode.property.test.ts src/storage/portable/Brc38StagingBinding.property.test.ts src/storage/portable/Brc38StagingCleanupError.property.test.ts src/storage/portable/Brc38StagingOwnershipNode.property.test.ts src/storage/portable/KnexBrc38StagingStore.property.test.ts src/storage/schema/knexDatabaseSystem.property.test.ts src/storage/snapshot/journal/SnapshotJournalDeltaFrame.property.test.ts src/storage/snapshot/journal/SnapshotJournalDeltaPage.property.test.ts src/storage/snapshot/journal/SnapshotJournalDestinationStage.property.test.ts src/storage/snapshot/journal/SnapshotJournalDestinationWindow.property.test.ts src/storage/snapshot/journal/SnapshotJournalIdentityLedger.property.test.ts src/storage/snapshot/journal/SnapshotJournalIdentityRetirements.property.test.ts src/storage/snapshot/journal/SnapshotJournalSourceGenerations.property.test.ts src/storage/snapshot/journal/SnapshotJournalSourceIdentities.property.test.ts src/storage/sync/StorageAccessQueue.property.test.ts",
    "qualify:released-sync": "node test/compatibility/releasedWalletSync.cjs",
    "test:manual": "pnpm build && node ../../../scripts/run-governed-test.mjs manual",
    "test:live": "pnpm build && node ../../../scripts/run-governed-test.mjs live",
    "operator:build": "pnpm build && tsc --project operator/tsconfig.json --pretty false",
    "operator": "pnpm operator:build && node .operator-build/cli.js",
    "bench:action-batch": "pnpm build && jest --runInBand --runTestsByPath benchmarks/action-batch.bench.test.ts --testPathIgnorePatterns=man.test.ts",
    "bench:create-action-funding": "pnpm build && jest --runInBand --runTestsByPath benchmarks/create-action-funding.bench.test.ts --testPathIgnorePatterns=man.test.ts",
    "bench:create-action-beef": "pnpm build && jest --runInBand --runTestsByPath benchmarks/create-action-beef.bench.test.ts --testPathIgnorePatterns=man.test.ts",
    "bench:storage-sync": "pnpm build && jest --runInBand --runTestsByPath benchmarks/storage-sync.bench.test.ts benchmarks/resumable-sync.bench.test.ts --testPathIgnorePatterns=man.test.ts",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/wallet/wallet-toolbox/{README.md,jest.config.cjs,package.json,tsconfig*.json}\"",
    "lint": "oxlint src test benchmarks examples operator --deny-warnings",
    "lint:ci": "pnpm lint",
    "pack:check": "pnpm build && node ../../../scripts/check-package-artifact.mjs . --modes cjs --exports Wallet,WalletSigner,WalletStorageManager,StorageClient,StorageKnex,Services,Setup,WalletPermissionsManager,WalletSettingsManager,LocalChainTracker,FixedWindowBulkFileDownloadBudget,DurableFileBulkFileDownloadBudget,BulkFileDataCacheFs,NodeBulkFileDataValidator,sdk,DeviceBackupController,migrateDeviceBackupPreferences,BrowserArgon2idWorkerBackend,installBrowserArgon2idWorker,mergeAuthenticatedBrc39NativeInactive,importBrc39ComposedNativeProfile,retryInactiveBrc39ComposedNativeImport,recoverPendingBrc39ComposedNativeImport,recoverExpiredPendingBrc39ComposedNativeImport,recoverBrc39ComposedNativeImport --entry-exports \"./out/src/sdk=WalletError|WERR_BAD_REQUEST|WERR_INTERNAL|WERR_INVALID_PARAMETER|WERR_UNAUTHORIZED;./portable=canonicalPortableChunks|projectBrc38PackedRow|createBrc38Stream|readBrc38JsonStream|Brc39StreamFrame|encodeBrc39StreamPrefix|BRC39_STREAM_DEFAULT_KDF;./portable/node=canonicalPortableChunks|projectBrc38PackedRow|createBrc38Stream|readBrc38JsonStream|Brc39StreamFrame|encodeBrc39StreamPrefix|BRC39_STREAM_DEFAULT_KDF|openBrc38KnexSource|encryptBrc39StreamToQuarantine|decryptBrc39StreamToQuarantine|createBrc39NodeFileQuarantine\" && tsc --project test/consumer/tsconfig.json",
    "typecheck": "tsc --build --pretty false && tsc --project examples/tsconfig.json --pretty false && tsc --project operator/tsconfig.json --noEmit --pretty false",
    "build": "tsc --build && node src/storage/portable/native/copy_artifacts.cjs && node src/storage/portable/native/generate_shared_quota_sources.cjs --check",
    "prepublishOnly": "pnpm build",
    "doc": "ts2md",
    "sync-versions": "node syncVersions.js",
    "test:snapshot-archive-crash": "pnpm build && node test/storage/snapshotArchiveCrash.cjs",
    "test:snapshot-archive-mysql": "pnpm build && node test/storage/runSnapshotArchiveMysql.cjs",
    "test:snapshot-journal-crash": "pnpm build && node test/storage/snapshotJournalSqliteCrash.cjs",
    "test:snapshot-journal-mysql": "pnpm build && node test/storage/runSnapshotJournalMysql.cjs",
    "bench:snapshot-program": "pnpm build && jest --runInBand --watchman=false --runTestsByPath benchmarks/snapshot-program.bench.test.ts benchmarks/snapshot-portable.bench.test.ts benchmarks/snapshot-native-program.bench.test.ts --testPathIgnorePatterns=man.test.ts"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/wallet/wallet-toolbox#readme",
  "dependencies": {
    "@bsv/auth-express-middleware": "workspace:^",
    "@bsv/payment-express-middleware": "workspace:^",
    "@noble/hashes": "2.4.0",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^13.0.3",
    "body-parser": "^2.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.3",
    "knex": "^3.3.0",
    "mysql2": "^3.24.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@bsv/verifast": "workspace:^",
    "@jest/globals": "^30.5.1",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "cors": "^2.8.6",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "fs-extra": "^11.4.0",
    "jest": "^30.5.1",
    "oxlint": "^1.83.0",
    "pg": "^8.23.0",
    "picocolors": "^1.1.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts2md": "^0.2.8",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.8.0 || ^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  },
  "typesVersions": {
    "*": {
      "portable": [
        "out/src/storage/portable/stream.d.ts"
      ],
      "portable/node": [
        "out/src/storage/portable/node.d.ts"
      ]
    }
  }
}
