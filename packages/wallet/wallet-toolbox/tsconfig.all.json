{
  "extends": "../../../config/typescript/dual-runtime.json",
  "compilerOptions": {
    "rootDir": ".", // Include both src and test directories
    "outDir": "./out",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "module": "commonjs",
    "sourceMap": true,
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "noImplicitOverride": true,
    "paths": {
      "@bsv/sdk": ["../../sdk/dist/cjs/mod.d.ts"]
    }
  },
  "files": [
    "test/storage/portableAdmissionChild.ts",
    "test/storage/portableAuthenticatedChild.ts",
    "test/storage/portableOwnershipChild.ts",
    "test/storage/portableResumeChild.ts",
    "test/utils/browserSnapshotRestoreFixture.ts",
    "test/utils/Brc38ImportEntityRestoreFixture.ts",
    "test/utils/snapshotJournalHistoricalFixture.ts",
    "benchmarks/snapshot-measurement-cases.ts"
  ],
  "include": ["src/**/*", "test/**/*"],
  "exclude": [
    "node_modules",
    "out",
    "client/out",
    "mobile/out",
    "src/**/__tests/**",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "test/**"
  ]
}
