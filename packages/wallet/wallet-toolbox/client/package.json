{
  "name": "@bsv/wallet-toolbox-client",
  "version": "2.4.4",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Browser-safe BRC-100 wallet, storage, signer, and services components",
  "main": "./out/index.client.cjs",
  "module": "./out/index.client.mjs",
  "browser": "./out/index.client.mjs",
  "types": "./out/index.client.d.cts",
  "exports": {
    ".": {
      "browser": {
        "types": "./out/index.client.d.mts",
        "default": "./out/index.client.mjs"
      },
      "import": {
        "types": "./out/index.client.d.mts",
        "default": "./out/index.client.mjs"
      },
      "require": {
        "types": "./out/index.client.d.cts",
        "default": "./out/index.client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out",
    "README.md",
    "LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/wallet/wallet-toolbox/client"
  },
  "author": "Tone Engel",
  "license": "SEE LICENSE IN LICENSE.txt",
  "keywords": [
    "bsv",
    "wallet",
    "BRC100"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/wallet/wallet-toolbox/src/index.client.ts\" \"packages/wallet/wallet-toolbox/src/services/chaintracker/chaintracks/index.{client,mobile}.ts\" \"packages/wallet/wallet-toolbox/src/services/chaintracker/chaintracks/Api/BlockHeaderApi.ts\" \"packages/wallet/wallet-toolbox/client/**/*.{json,md,ts}\"",
    "lint": "pnpm --workspace-root exec oxlint packages/wallet/wallet-toolbox/src/index.client.ts packages/wallet/wallet-toolbox/src/services/chaintracker/chaintracks/index.client.ts packages/wallet/wallet-toolbox/src/services/chaintracker/chaintracks/index.mobile.ts packages/wallet/wallet-toolbox/src/services/chaintracker/chaintracks/Api/BlockHeaderApi.ts packages/wallet/wallet-toolbox/client/test packages/wallet/wallet-toolbox/client/tsdown.config.ts packages/wallet/wallet-toolbox/client/vitest.config.ts --deny-warnings",
    "pack:check": "node ../../../../scripts/check-package-artifact.mjs . --exports Wallet,WalletSigner,WalletStorageManager,StorageClient,StorageIdb,Services,SetupClient,WalletPermissionsManager,WalletSettingsManager,sdk",
    "test": "vitest run",
    "test:browser": "node ../../../../scripts/check-wallet-toolbox-platform.mjs browser",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "prepublishOnly": "npm run build"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/wallet/wallet-toolbox/client#readme",
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.3"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.1.8"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@vitest/coverage-v8": "4.1.10",
    "@types/node": "^26.1.1",
    "esbuild": "0.28.1",
    "oxlint": "^1.75.0",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
