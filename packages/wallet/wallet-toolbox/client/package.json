{
  "name": "@bsv/wallet-toolbox-client",
  "version": "2.15.1",
  "type": "module",
  "sideEffects": [
    "./out/argon2id-worker.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Browser-safe BRC-100 wallet, storage, signer, and services components",
  "main": "./out/index.client.cjs",
  "module": "./out/index.client.mjs",
  "browser": "./out/index.client.mjs",
  "types": "./out/index.client.d.cts",
  "exports": {
    ".": {
      "browser": {
        "types": "./out/index.client.d.mts",
        "default": "./out/index.client.mjs"
      },
      "import": {
        "types": "./out/index.client.d.mts",
        "default": "./out/index.client.mjs"
      },
      "require": {
        "types": "./out/index.client.d.cts",
        "default": "./out/index.client.cjs"
      }
    },
    "./package.json": "./package.json",
    "./argon2id-worker": "./out/argon2id-worker.mjs"
  },
  "files": [
    "out",
    "README.md",
    "LICENSE.txt",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/wallet/wallet-toolbox/client"
  },
  "author": "BSV Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "keywords": [
    "bsv",
    "wallet",
    "BRC100"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && node build-argon2id-worker.mjs",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/wallet/wallet-toolbox/src/index.client.ts\" \"packages/wallet/wallet-toolbox/src/services/chaintracker/chaintracks/index.{client,mobile}.ts\" \"packages/wallet/wallet-toolbox/src/services/chaintracker/chaintracks/Api/BlockHeaderApi.ts\" \"packages/wallet/wallet-toolbox/client/**/*.{json,md,ts,cjs,mjs}\"",
    "lint": "pnpm --workspace-root exec oxlint packages/wallet/wallet-toolbox/src/index.client.ts packages/wallet/wallet-toolbox/src/services/chaintracker/chaintracks/index.client.ts packages/wallet/wallet-toolbox/src/services/chaintracker/chaintracks/index.mobile.ts packages/wallet/wallet-toolbox/src/services/chaintracker/chaintracks/Api/BlockHeaderApi.ts packages/wallet/wallet-toolbox/client/test packages/wallet/wallet-toolbox/client/argon2id-worker.ts packages/wallet/wallet-toolbox/client/build-argon2id-worker.mjs packages/wallet/wallet-toolbox/client/tsdown.config.ts packages/wallet/wallet-toolbox/client/vitest.config.ts --deny-warnings",
    "pack:check": "node ../../../../scripts/check-package-artifact.mjs . --exports Wallet,WalletSigner,WalletStorageManager,StorageClient,StorageIdb,Services,SetupClient,WalletPermissionsManager,WalletSettingsManager,LocalChainTracker,FixedWindowBulkFileDownloadBudget,InlineBulkFileDataValidator,registerArgon2idBackend,unregisterArgon2idBackend,WalletMonitorTask,attemptToPostReqsToNetwork,parseJsonRpc,stringifyJsonRpc,verifyUnlockScripts,sdk,DeviceBackupController,migrateDeviceBackupPreferences,BrowserArgon2idWorkerBackend,installBrowserArgon2idWorker,openBrc38IdbSource,createBrc38Stream,previewAuthenticatedBrc39BrowserImport,restoreAuthenticatedBrc39BrowserInactive,publishAuthenticatedBrc39BrowserProfile,retireExpiredBrc38BrowserProfile,encryptBrc39BrowserStreamToQuarantine --esm-only-entrypoints ./argon2id-worker --untyped-asset-entrypoints ./argon2id-worker",
    "test": "vitest run",
    "test:browser": "pnpm build && node ../../../../scripts/check-wallet-toolbox-platform.mjs browser && node test/sync-browser.mjs && node test/portable-program-browser.cjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "prepublishOnly": "npm run build",
    "bench:sync": "pnpm build && node test/sync-browser.mjs",
    "bench:snapshot-program": "pnpm build && node test/snapshot-measurement-browser.cjs"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/wallet/wallet-toolbox/client#readme",
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.3"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.8.0 || ^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@types/node": "^26.6.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "oxlint": "^1.83.0",
    "tsdown": "0.23.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.1",
    "puppeteer-core": "^25.4.0"
  }
}
