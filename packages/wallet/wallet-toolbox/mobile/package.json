{
  "name": "@bsv/wallet-toolbox-mobile",
  "version": "2.4.4",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Client only Wallet Storage",
  "main": "./out/src/index.mobile.js",
  "types": "./out/src/index.mobile.d.ts",
  "exports": {
    ".": {
      "types": "./out/src/index.mobile.d.ts",
      "require": "./out/src/index.mobile.js",
      "default": "./out/src/index.mobile.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "out/src",
    "README.md",
    "LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/wallet/wallet-toolbox/mobile"
  },
  "author": "Tone Engel",
  "license": "SEE LICENSE IN LICENSE.txt",
  "keywords": [
    "bsv",
    "wallet",
    "BRC100"
  ],
  "scripts": {
    "build": "tsc --build ../tsconfig.mobile.json"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/wallet/wallet-toolbox/mobile#readme",
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.3"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.1.8"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3"
  }
}
