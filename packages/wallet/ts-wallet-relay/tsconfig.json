{
  "extends": "../../../config/typescript/node-library.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
