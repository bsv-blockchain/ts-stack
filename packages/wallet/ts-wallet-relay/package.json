{
  "name": "@bsv/wallet-relay",
  "version": "0.3.4",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "BSV mobile wallet relay — relay server and pairing client",
  "author": "BSV Blockchain Association",
  "keywords": [
    "bsv",
    "wallet",
    "relay",
    "mobile",
    "pairing"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wallet-relay": "./bin/init.mjs"
  },
  "files": [
    "dist",
    "bin",
    "template",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/copy-cjs-types.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/wallet/ts-wallet-relay/**/*.{cjs,js,json,md,mjs,ts,tsx}\"",
    "lint": "oxlint build.mjs bin src tests --deny-warnings",
    "pack:check": "pnpm build && node ../../../scripts/check-package-artifact.mjs . --allow-source-prefixes template --consumer-dependencies react --exports QRSessionManager,WalletRelayService,WalletRequestHandler,WebSocketRelay,compileOriginMatcher --entry-exports \"./client=WalletPairingSession|WalletRelayClient|WalletRelayError;./react=QRDisplay|QRPairingCode|RequestLog|WalletConnectionModal|useQRPairing|useWalletRelayClient\" --bin wallet-relay --bin-args --help && node ../../../scripts/check-auth-express-consumers.mjs @bsv/wallet-relay",
    "test": "jest --config jest.config.cjs --watchman=false",
    "test:browser": "pnpm build && node ../../../scripts/check-browser-package.mjs .",
    "test:coverage": "jest --config jest.config.cjs --coverage --watchman=false",
    "test:property": "jest --config jest.config.cjs --selectProjects node --runInBand --watchman=false --runTestsByPath tests/pairingUri.property.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6",
    "@types/express": ">=4.17.0 <6",
    "express": ">=4.18.0 <6",
    "qrcode": ">=1.5.0",
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@bsv/sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "oxlint": "^1.76.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/wallet/ts-wallet-relay"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/wallet/ts-wallet-relay#readme",
  "license": "SEE LICENSE IN LICENSE.txt",
  "typesVersions": {
    "*": {
      "client": [
        "dist/client.d.ts"
      ],
      "react": [
        "dist/react.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  }
}
