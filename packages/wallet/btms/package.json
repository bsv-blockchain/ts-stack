{
  "name": "@bsv/btms",
  "version": "1.1.1",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "description": "Basic Token Management System - UTXO-based token management for BSV",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:property": "jest --runInBand --watchman=false --runTestsByPath src/__tests/BTMSHelpers.property.test.ts",
    "lint": "oxlint src --deny-warnings",
    "build": "tsdown src/index.ts --format cjs,esm --dts --sourcemap --clean --out-dir dist --tsconfig tsconfig.build.json",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/wallet/btms/src/**/*.ts\" \"packages/wallet/btms/README.md\" \"packages/wallet/btms/*.{cjs,json,ts}\"",
    "pack:check": "node ../../../scripts/check-package-artifact.mjs . --exports BTMS,BTMSToken,BTMS_TOPIC,BTMS_LOOKUP_SERVICE,BTMS_PROTOCOL_ID,BTMS_LABEL_PREFIX,BTMS_BASKET,DEFAULT_TOKEN_SATOSHIS,ISSUE_MARKER,MIN_TOKEN_AMOUNT,MAX_TOKEN_AMOUNT,parseCustomInstructions",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "prepublishOnly": "npm run build",
    "doc": "ts2md --inputFilename=src/index.ts --outputFilename=API.md --filenameSubstring=API --firstHeadingLevel=1"
  },
  "keywords": [
    "bsv",
    "bitcoin",
    "tokens",
    "btms",
    "overlay",
    "pushdrop"
  ],
  "author": "BSV Blockchain Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/wallet/btms"
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts2md": "^0.2.8",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "oxlint": "^1.75.0"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/wallet/btms#readme",
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
}
