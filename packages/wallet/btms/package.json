{
  "name": "@bsv/btms",
  "version": "1.1.1",
  "type": "module",
  "description": "Basic Token Management System - UTXO-based token management for BSV",
  "module": "dist/esm/src/index.js",
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/esm/src/index.js"
    }
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "oxlint src",
    "build": "tsc -b",
    "prepublishOnly": "npm run build",
    "doc": "ts2md --inputFilename=src/index.ts --outputFilename=API.md --filenameSubstring=API --firstHeadingLevel=1"
  },
  "keywords": [
    "bsv",
    "bitcoin",
    "tokens",
    "btms",
    "overlay",
    "pushdrop"
  ],
  "author": "BSV Blockchain Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/wallet/btms"
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts2md": "^0.2.8",
    "typescript": "^6.0.3",
    "oxlint": "^1.75.0"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/wallet/btms#readme",
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
}
