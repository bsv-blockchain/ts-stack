{
  "name": "metanet-apps",
  "version": "2.0.0",
  "description": "Publish and find Metanet apps with ease",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/ui/metanet-apps"
  },
  "type": "module",
  "main": "dist/cjs/mod.js",
  "module": "dist/esm/mod.js",
  "types": "dist/types/mod.d.ts",
  "files": [
    "PATENTS",
    "NOTICE",
    "dist",
    "LICENSE",
    "UPSTREAM_NOTICE"
  ],
  "scripts": {
    "test:property": "vitest run --config ../../../config/testing/ui-property.config.mjs tests/property/app-metadata.property.test.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "npm run build && jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage --coverageReporters=lcov --coverageReporters=text",
    "lint": "oxlint . --deny-warnings",
    "build": "pnpm run build:ts && pnpm run build:umd",
    "build:ts": "tsc -b && node scripts/build-commonjs.mjs",
    "build:umd": "webpack --config webpack.config.js",
    "dev": "tsc -b -w",
    "doc": "ts2md",
    "format:check": "prettier --check src tests scripts '*.{json,js,html,md,ts,tsx,cjs,mjs}'",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "pack:check": "pnpm build && node ../../../scripts/check-package-artifact.mjs . --modes cjs,esm --exports AppCatalog,DEFAULT_APP_LOOKUP_HOSTS --entry-exports './mod.ts=AppCatalog|DEFAULT_APP_LOOKUP_HOSTS'",
    "test:browser": "pnpm build && node ../../../scripts/check-browser-package.mjs ."
  },
  "author": "BSV Association",
  "license": "Apache-2.0",
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "fast-check": "^4.9.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-standard": "^12.0.2",
    "ts2md": "^0.2.8",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.74.0",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/mod.d.ts",
        "default": "./dist/esm/mod.js"
      },
      "require": {
        "types": "./dist/cjs/mod.d.ts",
        "default": "./dist/cjs/mod.js"
      }
    },
    "./mod.ts": {
      "import": {
        "types": "./dist/types/mod.d.ts",
        "default": "./dist/esm/mod.js"
      },
      "require": {
        "types": "./dist/cjs/mod.d.ts",
        "default": "./dist/cjs/mod.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/ui/metanet-apps#readme",
  "keywords": [
    "bsv",
    "ui"
  ],
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "mod.ts": [
        "dist/types/mod.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "@bsv/sdk": "^4.1.2"
  }
}
