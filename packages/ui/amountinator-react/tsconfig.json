{
  "compilerOptions": {
    "target": "es2018",
    "jsx": "react-jsx",
    "module": "Node16",
    "moduleResolution": "Node16",
    "sourceMap": true,
    "outDir": "out",
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "composite": true,
    "noImplicitOverride": true
  },
  "include": [
    "src*",
    "test*"
  ],
  "exclude": [
    "node_modules",
    "jest.config.ts"
  ],
  "references": [],
  "extends": "../../../config/typescript/browser.json"
}
