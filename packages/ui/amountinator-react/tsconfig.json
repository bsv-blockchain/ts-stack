{
  "compilerOptions": {
    "target": "es2018",
    "jsx": "react-jsx",
    "module": "Node16",
    "moduleResolution": "Node16",
    "sourceMap": true,
    "outDir": "out",
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "rootDir": ".",
    "composite": true,
    "noImplicitOverride": true,
    "inlineSources": true,
    "tsBuildInfoFile": "./node_modules/.cache/amountinator-react.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "jest.config.ts"],
  "references": [],
  "extends": "../../../config/typescript/browser.json"
}
