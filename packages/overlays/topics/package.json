{
  "name": "@bsv/overlay-topics",
  "version": "1.6.1",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Canonical BSV overlay topic managers and lookup services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "oxlint src",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@bsv/overlay": "workspace:^",
    "@bsv/templates": "workspace:^",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "oxlint": "^1.75.0"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "BSV Blockchain Association",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/overlays/topics"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/overlays/topics#readme",
  "keywords": [
    "bsv",
    "overlay",
    "topic-manager",
    "lookup-service",
    "blockchain"
  ],
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
