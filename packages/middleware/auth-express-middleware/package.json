{
  "name": "@bsv/auth-express-middleware",
  "version": "2.1.2",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "BSV Blockchain mutual-authentication express middleware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/middleware/auth-express-middleware"
  },
  "type": "module",
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.mjs",
  "types": "./dist/mod.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/mod.d.mts",
        "default": "./dist/mod.mjs"
      },
      "require": {
        "types": "./dist/mod.d.cts",
        "default": "./dist/mod.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "doc": "ts2md --inputFilename=mod.ts --outputFilename=API.md --filenameSubstring=API --firstHeadingLevel=1",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/middleware/auth-express-middleware/**/*.{js,json,ts}\"",
    "lint": "oxlint mod.ts src --deny-warnings",
    "pack:check": "pnpm build && node ../../../scripts/check-package-artifact.mjs . --exports ExpressTransport,createAuthMiddleware",
    "prepublishOnly": "pnpm build",
    "test": "jest --runInBand",
    "test:property": "jest --runInBand src/__tests/authMiddlewareHelpers.property.test.ts",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/middleware/auth-express-middleware#readme",
  "keywords": [
    "BSV",
    "Blockchain",
    "Mutual-Authentication",
    "Express",
    "Middleware"
  ],
  "author": "BSV Blockchain Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "oxlint": "^1.75.0",
    "ts-jest": "^29.4.12",
    "ts2md": "^0.2.8",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mime-types": "^3.0.2"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
}
