{
  "name": "@bsv/auth",
  "version": "0.1.1",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Signed, expiry-bound, single-use wallet auth proofs for BSV apps.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "packages/middleware/auth"
  },
  "scripts": {
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:property": "jest --runInBand --watchman=false --runTestsByPath src/__tests__/core.property.test.ts",
    "test:watch": "jest --watch",
    "test:perf": "jest --config jest.perf.config.js --runInBand",
    "build": "tsdown src/index.ts --format cjs,esm --dts --sourcemap --clean --out-dir dist --tsconfig tsconfig.build.json",
    "format:check": "pnpm --workspace-root exec prettier --check \"packages/middleware/auth/src/**/*.ts\" \"packages/middleware/auth/*.{js,json,ts}\"",
    "lint": "oxlint src --deny-warnings",
    "pack:check": "node ../../../scripts/check-package-artifact.mjs . --exports AuthProofClient,AuthProofServer,createAuthProof,verifyAuthProof",
    "typecheck": "tsc --project tsconfig.typecheck.json"
  },
  "keywords": [
    "bsv",
    "auth",
    "wallet",
    "nonce",
    "signature"
  ],
  "author": "BSV Blockchain Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "commonjs",
  "devDependencies": {
    "@bsv/sdk": "workspace:^",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "oxlint": "^1.75.0",
    "tsdown": "0.22.14",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/packages/middleware/auth#readme",
  "peerDependencies": {
    "@bsv/sdk": "^2.1.6"
  },
  "peerDependenciesMeta": {
    "@bsv/sdk": {
      "optional": false
    }
  }
}
