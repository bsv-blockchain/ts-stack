# Template for secrets/staging.env and secrets/prod.env
ADMIN_TOKEN=replace-with-at-least-32-random-characters
BSV_NETWORK=mainnet                     # mainnet or testnet
GOOGLE_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=uhrp-storage
GCR_HOST=us-west1-docker.pkg.dev
GCR_IMAGE_NAME=uhrp/storage-server      # repo/image format for Artifact Registry
NODE_ENV=production                     # production or staging
HOSTING_DOMAIN=prod.example.com
SERVER_PRIVATE_KEY=your-server-private-key
MIN_HOSTING_MINUTES=180
PRICE_PER_GB_MO=0.03
WALLET_STORAGE_URL=https://wallet-storage.example.com
HTTP_PORT=8080

# OpenTelemetry. OTLP headers may contain credentials and should remain in the
# environment-specific secret managed by this service's existing sync flow.
OTEL_SERVICE_NAME=uhrp-server-cloud-bucket
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_DIAG=false
DEPLOY_ENV=production
LOG_LEVEL=info

# Public protocol access is the default. To restrict browser callers:
# UHRP_CORS_MODE=allowlist
# UHRP_CORS_ALLOWED_ORIGINS=https://wallet.example.com
# UHRP_CROSS_ORIGIN_RESOURCE_POLICY=cross-origin
# UHRP_CROSS_ORIGIN_OPENER_POLICY=unsafe-none
# UHRP_FRAME_OPTIONS=disabled
# UHRP_PERMISSIONS_POLICY=disabled
# UHRP_STRICT_TRANSPORT_SECURITY=false

# Bounded request and connection policy.
UHRP_JSON_MAX_BODY_BYTES=262144
UHRP_MAX_CONCURRENT_REQUESTS=200
UHRP_REQUEST_TIMEOUT_MS=60000
UHRP_HEADERS_TIMEOUT_MS=15000
UHRP_KEEP_ALIVE_TIMEOUT_MS=5000
UHRP_SOCKET_TIMEOUT_MS=60000
UHRP_MAX_REQUESTS_PER_SOCKET=1000

UHRP_PRE_AUTH_RATE_LIMIT_MAX=300
UHRP_PRE_AUTH_RATE_LIMIT_WINDOW_MS=60000
UHRP_AUTHENTICATED_RATE_LIMIT_MAX=1000
UHRP_AUTHENTICATED_RATE_LIMIT_WINDOW_MS=60000

# Set only to the exact number of trusted reverse proxies.
# TRUST_PROXY_HOPS=1

# Optional, omit if not necessary
DOCKERHUB_USERNAME=your_dockerhub_user
DOCKERHUB_PASSWORD=your_dockerhub_pat

# AFTER RUNNING setup.yaml
GCR_PUSH_KEY=your_gcr_push_key
GCP_STORAGE_CREDS=your_gcp_storage_creds
