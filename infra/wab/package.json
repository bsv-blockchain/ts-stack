{
  "name": "@bsv/wab-server",
  "private": true,
  "version": "1.4.10",
  "description": "Wallet Authentication Backend (WAB) server",
  "main": "dist/server.js",
  "scripts": {
    "start": "tsc && node --require ./dist/telemetry.js dist/server.js",
    "dev": "ts-node-dev --respawn --require ./src/telemetry.ts src/server.ts",
    "build": "tsc",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@bsv/sdk": "^2.1.9",
    "@bsv/wallet-toolbox": "^2.4.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.32.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "json-stable-stringify": "^1.3.0",
    "knex": "^3.2.10",
    "mysql2": "^3.22.5",
    "pino": "^10.3.1",
    "sqlite3": "^6.0.1",
    "twilio": "^6.0.2"
  },
  "overrides": {
    "form-data": ">=4.0.6",
    "picomatch": ">=4.0.4",
    "undici": ">=6.27.0 <7.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/sqlite3": "^5.1.0",
    "body-parser": "^2.3.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
