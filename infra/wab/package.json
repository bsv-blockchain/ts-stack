    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/sqlite3": "^5.1.0",
    "body-parser": "^2.2.2",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
