# Runtime and database
NODE_ENV=development
PORT=8080
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wab
DB_USER=wab
DB_PASS=replace-with-a-dedicated-database-password

# Wallet identity and storage
BSV_NETWORK=main
SERVER_PRIVATE_KEY=replace-with-a-dedicated-private-key
STORAGE_URL=https://wallet-storage.example.com
SHARE_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
COMMISSION_FEE=0

# Optional SMS authentication
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# OpenTelemetry. OTLP headers may contain credentials and must come from the
# deployment secret manager.
OTEL_SERVICE_NAME=wab
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_DIAG=false
DEPLOY_ENV=development
LOG_LEVEL=info

# Public browser protocol access is the default. Restrict origins only for a
# deliberately closed deployment; CSP remains a separate document policy.
# WAB_CORS_MODE=allowlist
# WAB_CORS_ALLOWED_ORIGINS=https://wallet.example.com
# WAB_CONTENT_SECURITY_POLICY=default-src 'self'
# WAB_CROSS_ORIGIN_RESOURCE_POLICY=cross-origin
# WAB_CROSS_ORIGIN_OPENER_POLICY=unsafe-none
# WAB_FRAME_OPTIONS=disabled
# WAB_PERMISSIONS_POLICY=disabled
# WAB_STRICT_TRANSPORT_SECURITY=false

# Bounded request, connection, and rate-limit policy
WAB_MAX_BODY_BYTES=262144
WAB_MAX_CONCURRENT_REQUESTS=200
WAB_REQUEST_TIMEOUT_MS=30000
WAB_HEADERS_TIMEOUT_MS=10000
WAB_KEEP_ALIVE_TIMEOUT_MS=5000
WAB_SOCKET_TIMEOUT_MS=30000
WAB_MAX_REQUESTS_PER_SOCKET=1000
WAB_PRE_AUTH_RATE_LIMIT_MAX=300
WAB_PRE_AUTH_RATE_LIMIT_WINDOW_MS=60000
WAB_AUTH_RATE_LIMIT_MAX=10
WAB_AUTH_RATE_LIMIT_WINDOW_MS=900000
WAB_ACCOUNT_DELETION_RATE_LIMIT_MAX=5
WAB_ACCOUNT_DELETION_RATE_LIMIT_WINDOW_MS=900000
WAB_USER_RATE_LIMIT_MAX=120
WAB_USER_RATE_LIMIT_WINDOW_MS=900000
WAB_FAUCET_RATE_LIMIT_MAX=5
WAB_FAUCET_RATE_LIMIT_WINDOW_MS=3600000
WAB_SHARE_RATE_LIMIT_MAX=10
WAB_SHARE_RATE_LIMIT_WINDOW_MS=900000

# Set only to the exact number of trusted reverse proxies.
# TRUST_PROXY_HOPS=1

# Development-only console authentication is disabled by default.
DEV_CONSOLE_AUTH_METHOD_ENABLED=false
