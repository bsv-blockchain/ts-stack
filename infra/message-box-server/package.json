{
  "name": "@bsv/messagebox-server",
  "private": true,
  "version": "1.1.20",
  "overrides": {
    "brace-expansion": "5.0.8",
    "gaxios": "7.3.0",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "main": "./out/src/compose.js",
  "exports": {
    ".": {
      "import": "./out/src/compose.js",
      "default": "./out/src/compose.js"
    },
    "./server": {
      "import": "./out/src/index.js",
      "default": "./out/src/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "start": "node --import ./out/src/telemetry.js out/src/index.js",
    "dev": "nodemon --inspect --watch .env --watch src --exec tsx src/index.ts",
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.mjs",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.mjs --coverage --coverageReporters=text --coverageReporters=html",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.mjs --watch",
    "format:check": "npx --no-install prettier --check \"**/*.{js,json,mjs,ts}\"",
    "lint": "oxlint src --deny-warnings",
    "typecheck": "tsc --project tsconfig.json --noEmit --incremental false",
    "clean": "rimraf out",
    "prebuild": "rimraf out"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.txt",
  "description": "",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mock-knex": "^0.4.8",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript/native": "npm:typescript@7.0.2",
    "axios": "^1.18.1",
    "axios-mock-adapter": "^2.1.0",
    "better-sqlite3": "^13.0.2",
    "jest": "^30.4.2",
    "mock-knex": "^0.4.13",
    "oxlint": "^1.76.0",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "@bsv/auth-express-middleware": "^2.1.5",
    "@bsv/authsocket": "^2.1.4",
    "@bsv/payment-express-middleware": "^2.1.4",
    "@bsv/sdk": "^2.2.15",
    "@bsv/wallet-toolbox": "^2.4.20",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.34.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "body-parser": "^2.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "firebase-admin": "^14.2.0",
    "knex": "^3.3.0",
    "mysql2": "^3.23.2",
    "pino": "^10.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
