# @bsv/webrtpay signalling relay. Every variable is read by the package's
# environment parser (`node dist/index.js --help` lists them). Empty values count
# as unset.

# Listener. HTTP probes (/health, /ready) and the WebSocket share this port.
PORT=8787
HOST=0.0.0.0

# Required unless HOST is a loopback address: the comma-separated wss:// urls
# clients dial and sign. Set it whenever a proxy fronts the relay.
PUBLIC_URLS=wss://relay.example.com

# Header the outermost proxy sets to the client's single address, e.g.
# cf-connecting-ip behind Cloudflare. Leave unset without such a proxy.
TRUSTED_IP_HEADER=

# Comma-separated STUN urls handed to authenticated clients.
STUN_URLS=

# Optional TURN. TURN_PROVIDER is coturn (default) or cloudflare. coturn REST
# needs TURN_SECRET and TURN_URLS together; Cloudflare needs
# CLOUDFLARE_TURN_KEY_ID and CLOUDFLARE_TURN_API_TOKEN together. A half or mixed
# configuration is refused. Secrets must come from the deployment secret manager.
TURN_PROVIDER=
TURN_SECRET=
TURN_URLS=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Lifetime of issued TURN credentials in seconds (Cloudflare caps it at 172800).
# TURN_TTL=600

# Admission and rate limits, whole numbers of at least 1 (defaults shown). The
# TURN_* limits require a TURN provider.
# MAX_SOCKETS=10000
# MAX_UNAUTHENTICATED_SOCKETS=1000
# SOCKETS_PER_IP=20
# CONNECTIONS_PER_IP_PER_MINUTE=30
# SOCKETS_PER_48=80
# CONNECTIONS_PER_48_PER_MINUTE=120
# SIGNALS_PER_RECIPIENT_PER_MINUTE=120
# SIGNALS_PER_PAIR_PER_MINUTE=6
# MAX_OVER_RATE_FRAMES=20
# TURN_PER_IP_PER_HOUR=6
# TURN_PER_48_PER_HOUR=24
# TURN_PER_HOUR=600

# OpenTelemetry. OTLP headers may contain credentials and must come from the
# deployment secret manager.
OTEL_SERVICE_NAME=webrtpay-relay
# No collector: telemetry is off. Opt in below for local console diagnostics.
OTEL_CONSOLE_EXPORTERS=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_DIAG=false
DEPLOY_ENV=development
LOG_LEVEL=info
