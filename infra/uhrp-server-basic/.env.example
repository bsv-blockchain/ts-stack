PRICE_PER_GB_MO=0.03
HOSTING_DOMAIN=localhost:8080
BSV_NETWORK=mainnet
WALLET_STORAGE_URL=https://storage.babbage.systems
SERVER_PRIVATE_KEY=replace-with-a-dedicated-private-key
HTTP_PORT=8080

# Public protocol access is the default. To restrict browser callers:
# UHRP_CORS_MODE=allowlist
# UHRP_CORS_ALLOWED_ORIGINS=http://localhost:3000
# UHRP_CROSS_ORIGIN_RESOURCE_POLICY=cross-origin
# UHRP_CROSS_ORIGIN_OPENER_POLICY=unsafe-none
# UHRP_FRAME_OPTIONS=disabled
# UHRP_PERMISSIONS_POLICY=disabled
# UHRP_STRICT_TRANSPORT_SECURITY=false

# Bounded request and connection policy.
UHRP_UPLOAD_MAX_BODY_BYTES=67108864
UHRP_JSON_MAX_BODY_BYTES=262144
UHRP_MAX_CONCURRENT_REQUESTS=100
UHRP_REQUEST_TIMEOUT_MS=300000
UHRP_HEADERS_TIMEOUT_MS=15000
UHRP_KEEP_ALIVE_TIMEOUT_MS=5000
UHRP_SOCKET_TIMEOUT_MS=300000
UHRP_MAX_REQUESTS_PER_SOCKET=1000

# Per-IP before auth and per-identity after BRC-103 auth.
UHRP_PRE_AUTH_RATE_LIMIT_MAX=300
UHRP_PRE_AUTH_RATE_LIMIT_WINDOW_MS=60000
UHRP_AUTHENTICATED_RATE_LIMIT_MAX=1000
UHRP_AUTHENTICATED_RATE_LIMIT_WINDOW_MS=60000

# Set only to the exact number of trusted reverse proxies.
# TRUST_PROXY_HOPS=1
