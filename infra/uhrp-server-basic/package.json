{
  "name": "@bsv/uhrp-lite",
  "version": "0.1.18",
  "overrides": {
    "brace-expansion": "5.0.8",
    "gaxios": "7.3.0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "main": "./out/src/index.js",
  "types": "./out/src/index.d.ts",
  "files": [
    "out/src",
    "src",
    "LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsv-blockchain/ts-stack.git",
    "directory": "infra/uhrp-server-basic"
  },
  "bugs": {
    "url": "https://github.com/bsv-blockchain/ts-stack/issues"
  },
  "homepage": "https://github.com/bsv-blockchain/ts-stack/tree/main/infra/uhrp-server-basic#readme",
  "author": "BSV Association",
  "license": "SEE LICENSE IN LICENSE.txt",
  "dependencies": {
    "@bsv/auth-express-middleware": "^2.1.6",
    "@bsv/payment-express-middleware": "^2.1.4",
    "@bsv/sdk": "^2.2.17",
    "@bsv/wallet-toolbox-client": "^2.4.20",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.34.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.18.1",
    "body-parser": "^2.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "pino": "^10.3.1",
    "prettyjson": "^1.2.5"
  },
  "scripts": {
    "start": "ts-node -r ./src/telemetry.ts src/index.ts",
    "start:prod": "node --require ./out/src/telemetry.js out/src/index.js",
    "dev": "nodemon --watch .env --watch src --exec \"node --inspect=0.0.0.0 -r ts-node/register -r ./src/telemetry.ts src/index.ts\"",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "oxlint src --deny-warnings"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/prettyjson": "^0.0.33",
    "@typescript/native": "npm:typescript@7.0.2",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "oxlint": "^1.76.0",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
