NODE_ENV=development
BSV_NETWORK=main
ENABLE_NGINX=false
HTTP_PORT=3998
SERVER_PRIVATE_KEY="replace-with-a-dedicated-private-key"
KNEX_DB_CONNECTION={"port":3112,"host":"mysql","user":"root","password":"rootPass","database":"wallet_storage"}
TAAL_API_KEY=
COMMISSION_FEE=0
COMMISSION_PUBLIC_KEY=
FEE_MODEL={"model":"sat/kb","value":1}

# OpenTelemetry. OTLP headers may contain credentials and must come from the
# deployment secret manager.
OTEL_SERVICE_NAME=wallet-infra
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_DIAG=false
DEPLOY_ENV=development
LOG_LEVEL=info

# Public protocol access is the default. To restrict browser callers:
# WALLET_STORAGE_CORS_MODE=allowlist
# WALLET_STORAGE_CORS_ALLOWED_ORIGINS=http://localhost:3000
# WALLET_STORAGE_CROSS_ORIGIN_RESOURCE_POLICY=cross-origin
# WALLET_STORAGE_CROSS_ORIGIN_OPENER_POLICY=unsafe-none
# WALLET_STORAGE_FRAME_OPTIONS=disabled
# WALLET_STORAGE_PERMISSIONS_POLICY=disabled
# WALLET_STORAGE_STRICT_TRANSPORT_SECURITY=false

# Bounded RPC/blob and connection policy.
WALLET_STORAGE_JSON_MAX_BODY_BYTES=31457280
WALLET_STORAGE_BINARY_MAX_BODY_BYTES=8388608
WALLET_STORAGE_MAX_CONCURRENT_REQUESTS=200
WALLET_STORAGE_REQUEST_TIMEOUT_MS=120000
WALLET_STORAGE_HEADERS_TIMEOUT_MS=15000
WALLET_STORAGE_KEEP_ALIVE_TIMEOUT_MS=5000
WALLET_STORAGE_SOCKET_TIMEOUT_MS=120000
WALLET_STORAGE_MAX_REQUESTS_PER_SOCKET=1000

# Rate-limit stores and proxy trust are configured through StorageServer
# options. Replicated deployments must use a shared store and an explicit
# trusted proxy hop/subnet policy.
