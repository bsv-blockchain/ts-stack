NODE_ENV=development
BSV_NETWORK=main
ENABLE_NGINX=false
HTTP_PORT=3998
# Defaults to 127.0.0.1 behind nginx and 0.0.0.0 in direct mode.
# WALLET_STORAGE_BIND_HOST=0.0.0.0
SERVER_PRIVATE_KEY="replace-with-a-dedicated-private-key"
KNEX_DB_CONNECTION={"port":3112,"host":"mysql","user":"root","password":"rootPass","database":"wallet_storage"}
TAAL_API_KEY=
COMMISSION_FEE=0
COMMISSION_PUBLIC_KEY=
FEE_MODEL={"model":"sat/kb","value":1}
WALLET_INFRA_ROLE=all

# Provider options. WALLET_STORAGE_* names take precedence; historical names
# remain accepted. Admin keys and JSON settings may be raw or base64 encoded.
WALLET_STORAGE_TAAL_API_KEY=
WALLET_STORAGE_WHATSONCHAIN_API_KEY=
WALLET_STORAGE_BITAILS_API_KEY=
WALLET_STORAGE_ARCADE_URL=
WALLET_STORAGE_ARCADE_API_KEY=
WALLET_STORAGE_ARCADE_CALLBACK_TOKEN=
WALLET_STORAGE_EXCHANGE_RATES_API_KEY=
WALLET_STORAGE_GORILLAPOOL_ARC_ENABLED=true
# WALLET_STORAGE_ADMIN_IDENTITY_KEYS=02...,03...

# Optional authenticated monitor operator UI/API. Enable this only on the
# singleton all/monitor role and expose its separate port through a private
# operator path. The private key and allowed client identity keys are secrets.
WALLET_STORAGE_MONITOR_ADMIN_ENABLED=false
WALLET_STORAGE_MONITOR_ADMIN_HOST=127.0.0.1
WALLET_STORAGE_MONITOR_ADMIN_PORT=8082
# WALLET_STORAGE_MONITOR_ADMIN_PRIVATE_KEY=
# WALLET_STORAGE_MONITOR_ADMIN_ALLOWED_ORIGINS=https://operator.example

# OpenTelemetry. OTLP headers may contain credentials and must come from the
# deployment secret manager.
OTEL_SERVICE_NAME=wallet-infra
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_DIAG=false
DEPLOY_ENV=development
LOG_LEVEL=info

# Public protocol access is the default. To restrict browser callers:
# WALLET_STORAGE_CORS_MODE=allowlist
# WALLET_STORAGE_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Omit to reflect well-formed preflight request headers; set only for a strict
# browser header allowlist:
# WALLET_STORAGE_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Correlation-ID
# WALLET_STORAGE_CROSS_ORIGIN_RESOURCE_POLICY=cross-origin
# WALLET_STORAGE_CROSS_ORIGIN_OPENER_POLICY=unsafe-none
# WALLET_STORAGE_FRAME_OPTIONS=disabled
# WALLET_STORAGE_PERMISSIONS_POLICY=disabled
# WALLET_STORAGE_STRICT_TRANSPORT_SECURITY=false

# Bounded RPC/blob and connection policy.
WALLET_STORAGE_RESOURCE_PROFILE=standard
WALLET_STORAGE_JSON_MAX_BODY_BYTES=8388608
WALLET_STORAGE_BINARY_MAX_BODY_BYTES=8388608
WALLET_STORAGE_MAX_RESPONSE_BYTES=8388608
WALLET_STORAGE_MAX_CONCURRENT_REQUESTS=24
WALLET_STORAGE_MAX_CONNECTIONS=1000
WALLET_STORAGE_RPC_DEFAULT_LIST_LIMIT=1000
WALLET_STORAGE_RPC_MAX_LIST_LIMIT=1000
WALLET_STORAGE_RPC_MAX_ARRAY_ITEMS=1000000
WALLET_STORAGE_RPC_MAX_RESPONSE_BYTES=8388608
WALLET_STORAGE_REQUEST_TIMEOUT_MS=120000
WALLET_STORAGE_HEADERS_TIMEOUT_MS=15000
WALLET_STORAGE_KEEP_ALIVE_TIMEOUT_MS=5000
WALLET_STORAGE_SOCKET_TIMEOUT_MS=120000
WALLET_STORAGE_MAX_REQUESTS_PER_SOCKET=1000
WALLET_STORAGE_TRUST_PROXY_HOPS=0
WALLET_STORAGE_MONITOR_START_TASKS=true
WALLET_STORAGE_MONITOR_STARTUP_TASK_MODE=default
WALLET_STORAGE_DB_POOL_MIN=2
WALLET_STORAGE_DB_POOL_MAX=10
WALLET_STORAGE_DB_CREATE_TIMEOUT_MS=10000
WALLET_STORAGE_DB_ACQUIRE_TIMEOUT_MS=30000
WALLET_STORAGE_DB_IDLE_TIMEOUT_MS=600000
WALLET_STORAGE_DB_REAP_INTERVAL_MS=60000
WALLET_STORAGE_DB_CREATE_RETRY_MS=200

# Set WALLET_STORAGE_TRUST_PROXY_HOPS to the exact number of trusted ingress
# hops (commonly 1 in Kubernetes). Keep 0 for direct exposure. Replicated
# deployments must also use a shared rate-limit store or an equivalent gateway
# policy.
