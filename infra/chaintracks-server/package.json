{
  "name": "chaintracks-server",
  "version": "1.0.14",
  "overrides": {
    "gaxios": "7.3.0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "description": "TypeScript Express server wrapping ChaintracksService from @bsv/wallet-toolbox",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "lint": "oxlint src --deny-warnings",
    "start": "node --require ./dist/telemetry.js dist/server.js",
    "start:test": "CHAIN=test node --require ./dist/telemetry.js dist/server.js",
    "start:custom": "node --require ./dist/telemetry.js dist/server-custom.js",
    "start:prefix": "node --require ./dist/telemetry.js dist/server-with-prefix.js",
    "dev": "ts-node src/server.ts",
    "dev:test": "CHAIN=test ts-node src/server.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "bsv",
    "bitcoin",
    "blockchain",
    "chaintracks",
    "headers",
    "express",
    "api"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.txt",
  "dependencies": {
    "@bsv/wallet-toolbox": "^2.4.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.34.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "body-parser": "^2.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "^1.76.0",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
