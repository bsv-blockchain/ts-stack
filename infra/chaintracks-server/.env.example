# ChaintracksService Configuration

# Chain: main | test | stn | ttn | tstn
CHAIN=main

# Server port (default: 3011)
PORT=3011

# Routing prefix for API endpoints (optional)
# Example: /api/v1 results in /api/v1/getInfo
ROUTING_PREFIX=

# Optional WhatsOnChain key for higher mainnet limits. ChainTracks works
# anonymously below the documented 3 requests/second public limit. WoC is not
# used for stn, ttn, or tstn.
WHATSONCHAIN_API_KEY=

# Preferred Arcade/go-chaintracks v2 source. Mainnet, testnet, and TTN use
# public defaults when this is empty. Set an explicit URL for STN/TSTN, or set
# STN_ARCADE_URL/TSTN_ARCADE_URL. Use "disabled" or "none" to disable it.
CHAINTRACKS_UPSTREAM_URL=
# Inferred as /chaintracks/v2 unless the URL already ends in /v2.
CHAINTRACKS_UPSTREAM_API_PREFIX=
CHAINTRACKS_UPSTREAM_MAX_HEADERS=1000
# Mainnet/testnet only. The default keyless fallback is rate limited.
CHAINTRACKS_DISABLE_WHATSONCHAIN=false
STN_ARCADE_URL=
STN_CHAINTRACKS_URL=
TSTN_ARCADE_URL=
TSTN_CHAINTRACKS_URL=

# Logging level
LOG_LEVEL=info

# OpenTelemetry. Leave the endpoint unset for local console exporters. Supply
# OTLP headers through secret management, never a committed environment file.
OTEL_SERVICE_NAME=chaintracks-server
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_DIAG=false
DEPLOY_ENV=development

# SOURCE_CDN_URL - Remote CDN to download bulk headers FROM (fallback when local files don't exist)
# This is where the ingestor will fetch headers if they're not in the local filesystem.
# Set an explicit empty value to disable the CDN source.
# Example: https://cdn.projectbabbage.com/blockheaders
SOURCE_CDN_URL=https://cdn.projectbabbage.com/blockheaders/

# Verify and persist immutable source objects before serving them. The cache is
# consulted before the network and survives process/container restarts.
CHAINTRACKS_BULK_FILE_CACHE=true
# Remote bulk bytes reserved per process per hour. Use -1 for unlimited only
# when an external egress budget is enforced.
CHAINTRACKS_UPSTREAM_DOWNLOAD_MAX_BYTES_PER_HOUR=536870912

# Bulk Headers CDN Configuration
# Enable bulk headers CDN hosting (set to 'true' to enable)
ENABLE_BULK_HEADERS_CDN=true

# CDN Host URL - The public URL where the CDN server is accessible
# This is used as the rootFolder in bulk headers JSON metadata file
# Default: http://localhost:PORT+1 (CDN runs on port after main service)
# Example: https://headers.yourdomain.com
CDN_HOST_URL=

# Path where bulk header files will be exported and served from
# Can be relative (e.g., ./public/headers) or absolute (e.g., /var/www/headers)
# Leave empty to use default: ./public/headers (relative to project root)
BULK_HEADERS_PATH=

# Auto-export interval in milliseconds (default: 240000000 = 400 blocks around 67 hours)
# The system checks if headers should be exported based on 100k boundaries
BULK_HEADERS_AUTO_EXPORT_INTERVAL=240000000

# Public protocol access is the default. To restrict browser callers:
# CHAINTRACKS_CORS_MODE=allowlist
# CHAINTRACKS_CORS_ALLOWED_ORIGINS=https://wallet.example.com
# CHAINTRACKS_CDN_CORS_MODE=allowlist
# CHAINTRACKS_CDN_CORS_ALLOWED_ORIGINS=https://wallet.example.com
# Omit the matching *_CORS_ALLOWED_HEADERS value to reflect well-formed
# preflight request headers; set one only for a strict browser header allowlist.
# CHAINTRACKS_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Correlation-ID
# CHAINTRACKS_CDN_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Correlation-ID
# The same API/CDN prefixes configure browser response headers, for example:
# CHAINTRACKS_CROSS_ORIGIN_RESOURCE_POLICY=cross-origin
# CHAINTRACKS_CROSS_ORIGIN_OPENER_POLICY=unsafe-none
# CHAINTRACKS_FRAME_OPTIONS=disabled
# CHAINTRACKS_PERMISSIONS_POLICY=disabled
# CHAINTRACKS_STRICT_TRANSPORT_SECURITY=false

# API edge policy.
CHAINTRACKS_RESOURCE_PROFILE=standard
CHAINTRACKS_MAX_BODY_BYTES=262144
CHAINTRACKS_MAX_RESPONSE_BYTES=4194304
CHAINTRACKS_MAX_CONCURRENT_REQUESTS=64
CHAINTRACKS_MAX_CONNECTIONS=1000
CHAINTRACKS_HEADERS_DEFAULT_LIMIT=1000
CHAINTRACKS_HEADERS_MAX_LIMIT=1000
CHAINTRACKS_REQUEST_TIMEOUT_MS=60000
CHAINTRACKS_HEADERS_TIMEOUT_MS=15000
CHAINTRACKS_KEEP_ALIVE_TIMEOUT_MS=5000
CHAINTRACKS_SOCKET_TIMEOUT_MS=60000
CHAINTRACKS_MAX_REQUESTS_PER_SOCKET=1000

# Historical header queries have their own process-local abuse limit.
CHAINTRACKS_HISTORICAL_RATE_LIMIT_WINDOW_MS=60000
CHAINTRACKS_HISTORICAL_RATE_LIMIT_MAX=600
# Set only when every direct connection comes from a trusted reverse proxy.
TRUST_PROXY_HOPS=

# Static header CDN edge policy.
CHAINTRACKS_CDN_MAX_CONCURRENT_REQUESTS=100
CHAINTRACKS_CDN_MAX_CONNECTIONS=1000
CHAINTRACKS_CDN_REQUEST_TIMEOUT_MS=30000
CHAINTRACKS_CDN_HEADERS_TIMEOUT_MS=10000
CHAINTRACKS_CDN_KEEP_ALIVE_TIMEOUT_MS=5000
CHAINTRACKS_CDN_SOCKET_TIMEOUT_MS=30000
CHAINTRACKS_CDN_MAX_REQUESTS_PER_SOCKET=1000
