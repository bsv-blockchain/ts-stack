MONGO_URL=mongodb://root:example@mongodb:27017
KNEX_URL=mysql://appuser:apppass@mysql:3306/appdb
SERVER_PRIVATE_KEY=replace-with-a-dedicated-private-key
WALLET_STORAGE_URL=https://store-us-1.bsvb.tech
HOSTING_URL=https://your.overlay.network
ARC_API_KEY=
ARC_CALLBACK_TOKEN=
ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
ARCADE_API_KEY=
ARCADE_DEPLOYMENT_ID=your-overlay-node
CHAINTRACKS_URL=
CHAINTRACKS_API_PREFIX=/chaintracks/v2
USE_ARCADE_CHAINTRACKS=true
THROW_ON_BROADCAST_FAIL=true
NETWORK=main
NODE_NAME=your-overlay-node
ADMIN_TOKEN=replace-with-at-least-32-random-characters
GASP_ENABLED=false
BASM_ENABLED=false
BASM_REORG_STREAM_ENABLED=true
BASM_REORG_SCAN_DEPTH=3
BASM_BLOCK_POLL_INTERVAL_MS=600000
UNPROVEN_EVICTION_BLOCKS=144
UNPROVEN_MAINTENANCE_INTERVAL_MS=3600000

# OpenTelemetry. OTLP headers may contain credentials and must come from the
# deployment secret manager.
OTEL_SERVICE_NAME=overlay-server
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_DIAG=false
DEPLOY_ENV=development
LOG_LEVEL=info

# Public browser protocol access is the default. Restriction and browser
# response headers are deployment choices:
# OVERLAY_CORS_MODE=allowlist
# OVERLAY_CORS_ALLOWED_ORIGINS=https://admin.example.com
# OVERLAY_CONTENT_SECURITY_POLICY=default-src 'self'; connect-src 'self' https:
# OVERLAY_CROSS_ORIGIN_RESOURCE_POLICY=cross-origin
# OVERLAY_CROSS_ORIGIN_OPENER_POLICY=unsafe-none
# OVERLAY_FRAME_OPTIONS=disabled
# OVERLAY_PERMISSIONS_POLICY=disabled
# OVERLAY_STRICT_TRANSPORT_SECURITY=false

# Bounded lookup, maintenance, admin, request, response, and connection policy.
OVERLAY_RESOURCE_PROFILE=standard
OVERLAY_MAX_BODY_BYTES=8388608
OVERLAY_MAX_RESPONSE_BYTES=8388608
OVERLAY_MAX_CONCURRENT_REQUESTS=24
OVERLAY_MAX_CONNECTIONS=1000
OVERLAY_MAX_LOOKUP_RESULTS=1000
OVERLAY_MAX_BASM_TXIDS=1000
OVERLAY_MAX_BASM_ANCHOR_RANGE=1000
OVERLAY_ADMIN_LIST_DEFAULT_LIMIT=50
OVERLAY_ADMIN_LIST_MAX_LIMIT=200
OVERLAY_ADMIN_LIST_MAX_OFFSET=100000
OVERLAY_JANITOR_BATCH_SIZE=250
OVERLAY_JANITOR_MAX_REPORT_RESULTS=1000
OVERLAY_REQUEST_TIMEOUT_MS=120000
OVERLAY_HEADERS_TIMEOUT_MS=15000
OVERLAY_KEEP_ALIVE_TIMEOUT_MS=5000
OVERLAY_SOCKET_TIMEOUT_MS=120000
OVERLAY_MAX_REQUESTS_PER_SOCKET=1000
