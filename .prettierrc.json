{
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false,
  "overrides": [
    {
      "files": "infra/wallet-infra/**/*",
      "options": {
        "printWidth": 80
      }
    },
    {
      "files": "packages/wallet/wallet-toolbox/**/*",
      "options": {
        "printWidth": 120
      }
    }
  ]
}
