{
  "name": "@bsv/ts-stack",
  "private": true,
  "description": "BSV TypeScript monorepo — SDK, Wallet, Network, Overlay, Messaging, Middleware, Helpers",
  "scripts": {
    "build": "pnpm -r --filter '!@bsv/ts-stack' run build",
    "test": "pnpm -r --filter '!@bsv/ts-stack' run test",
    "lint": "pnpm -r --filter '!@bsv/ts-stack' run lint",
    "clean": "pnpm -r --filter '!@bsv/ts-stack' run clean",
    "sync-versions": "node scripts/sync-versions.mjs",
    "check-versions": "node scripts/check-versions.mjs",
    "health:baseline": "node scripts/repository-health.mjs --update-contract-baseline",
    "health:check": "node --test scripts/repository-health.test.mjs && node scripts/repository-health.mjs",
    "health:report": "node scripts/repository-health.mjs --format markdown",
    "audit:security": "pnpm audit --audit-level=high",
    "conformance": "node conformance/runner/src/runner.js",
    "docs:asyncapi": "node scripts/generate-asyncapi-html.mjs",
    "docs:dev": "pnpm --filter docs-site dev",
    "docs:build": "pnpm --filter docs-site build",
    "docs:preview": "pnpm --filter docs-site preview"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24.11",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2"
}
