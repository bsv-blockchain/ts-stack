{
  "name": "@bsv/ts-stack",
  "private": true,
  "description": "BSV TypeScript monorepo — SDK, Wallet, Network, Overlay, Messaging, Middleware, Helpers",
  "scripts": {
    "build": "pnpm -r --filter '!@bsv/ts-stack' run build",
    "test": "pnpm -r --filter '!@bsv/ts-stack' run test",
    "lint": "pnpm -r --filter '!@bsv/ts-stack' run lint",
    "clean": "pnpm -r --filter '!@bsv/ts-stack' run clean",
    "sync-versions": "node scripts/sync-versions.mjs",
    "check-versions": "node scripts/check-versions.mjs",
    "conformance": "node conformance/runner/src/runner.js",
    "docs:asyncapi": "node scripts/generate-asyncapi-html.mjs",
    "docs:dev": "pnpm --filter docs-site dev",
    "docs:build": "pnpm --filter docs-site build",
    "docs:preview": "pnpm --filter docs-site preview"
  },
  "devDependencies": {
    "@asyncapi/generator": "^3.3.0",
    "@asyncapi/html-template": "^3.5.6"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "mongodb-memory-server",
      "sqlite3"
    ],
    "overrides": {
      "jest-environment-node": "^30.3.0",
      "jest-mock": "^30.3.0",
      "tar": ">=7.5.8",
      "jsonpath-plus": ">=10.2.0",
      "qs": ">=6.15.2",
      "ws": ">=8.20.1",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1",
      "xml2js": ">=0.5.0",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "@bsv/sdk": "2.1.3",
      "knex": "3.2.10",
      "better-sqlite3": "12.10.0",
      "mysql2": "3.22.3",
      "typescript": "^6.0.3"
    }
  }
}
